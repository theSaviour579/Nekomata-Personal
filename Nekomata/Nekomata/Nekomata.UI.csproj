<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Nekomata</AssemblyName>
    <Product>Nekomata Personal Assistant</Product>
    <VersionPrefix>0.6.1</VersionPrefix>
    <KokoroSharpVersion>0.8.4</KokoroSharpVersion>
    <Authors>Nekomata Assistant</Authors>
    <UserSecretsId>2bff312d-aa43-432a-bd88-844804742564</UserSecretsId>
	  <ApplicationIcon>Assets\Images\App.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
    <None Remove="Assets\Images\App.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="System.Speech" Version="10.0.0" />
    <!-- Speech to text on this PC (AI-use policy); model file in %LOCALAPPDATA%\Nekomata\models -->
    <PackageReference Include="Whisper.net" Version="1.7.4" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.7.4" />
    <!-- Guardian's voice on this PC: Kokoro (MIT / Apache 2.0); model downloads once on first use -->
    <PackageReference Include="KokoroSharp.CPU" Version="0.8.4" />
  </ItemGroup>

  <!-- Keep installed speech offline. KokoroSharp's own target copies voices to ordinary build output only;
       release automation supplies the checksum-verified model through KokoroModelPath. -->
  <ItemGroup>
    <Content Include="$(NuGetPackageRoot)kokorosharp\$(KokoroSharpVersion)\content\voices\**\*">
      <Link>voices\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(KokoroModelPath)" Condition="'$(KokoroModelPath)' != '' and Exists('$(KokoroModelPath)')">
      <Link>kokoro.onnx</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nekomata.AI\Nekomata.AI.csproj" />
    <ProjectReference Include="..\Nekomata.Core\Nekomata.Core.csproj" />
    <ProjectReference Include="..\Nekomata.Data\Nekomata.Data.csproj" />
    <ProjectReference Include="..\Nekomata.Integrations\Nekomata.Integrations.csproj" />
    <ProjectReference Include="..\Nekomata.Models\Nekomata.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Images\App.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

</Project>
