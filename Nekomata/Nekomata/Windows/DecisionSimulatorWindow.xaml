<Window x:Class="Nekomata.UI.Windows.DecisionSimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guardian · decision simulator" Width="1180" Height="800" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource NekoBackgroundBrush}" TextElement.Foreground="{DynamicResource NekoTextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="DECISION SIMULATOR" Foreground="{DynamicResource NekoAccentBrush}" FontSize="30" FontWeight="Bold"/><TextBlock Text="Compare the next working days before changing the plan. Meetings remain protected and every consequence stays reviewable." Foreground="{DynamicResource NekoMutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource NekoCardGradientBrush}" BorderBrush="{DynamicResource NekoBorderSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,18,0,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="OBJECTIVE TO PROTECT" Foreground="{DynamicResource NekoAccentBrush}" FontWeight="Bold" FontSize="11"/><ComboBox ItemsSource="{Binding DecisionSimulationCandidates}" SelectedItem="{Binding SelectedDecisionCandidate}" DisplayMemberPath="Title" Margin="0,6,0,0" MinHeight="34"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="HORIZON (WORKDAYS)" Foreground="{DynamicResource NekoAccentBrush}" FontWeight="Bold" FontSize="11"/><ComboBox ItemsSource="{Binding DecisionSimulationHorizonOptions}" SelectedItem="{Binding DecisionSimulationHorizonDays}" Margin="0,6,0,0" MinHeight="34"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="LEAVE TODAY AT" Foreground="{DynamicResource NekoAccentBrush}" FontWeight="Bold" FontSize="11"/><TextBox Text="{Binding DecisionSimulationLeaveTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" MinHeight="34" Padding="8,5"/></StackPanel>
                <Button Grid.Column="5" Content="RE-RUN COMPARISON" Command="{Binding RefreshDecisionSimulationCommand}" Margin="18,17,0,0" Padding="15,8"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="0.34*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.66*"/></Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding DecisionScenarios}" SelectedItem="{Binding SelectedDecisionScenario}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource NekoSurfaceAltBrush}" BorderBrush="{DynamicResource NekoBorderSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource NekoMutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/><TextBlock Text="{Binding FinishLabel}" Foreground="{DynamicResource NekoAccentBrush}"/><TextBlock Text="{Binding RiskLabel}" Foreground="{DynamicResource NekoWarningBrush}" Margin="0,4,0,0"/><TextBlock Text="{Binding DifferenceLabel}" Foreground="{DynamicResource NekoMutedTextBrush}" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            <Border Grid.Column="2" Background="{DynamicResource NekoCardGradientBrush}" BorderBrush="{DynamicResource NekoSpiritPurpleBrush}" BorderThickness="1" CornerRadius="14" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding SelectedDecisionScenario}">
                <TextBlock Text="{Binding Title}" FontSize="23" FontWeight="Bold"/><TextBlock Text="{Binding ComparisonSummary}" TextWrapping="Wrap" Foreground="{DynamicResource NekoMutedTextBrush}" Margin="0,5,0,0"/>
                <TextBlock Text="SCHEDULE" Foreground="{DynamicResource NekoAccentBrush}" FontWeight="Bold" Margin="0,18,0,7"/><ItemsControl ItemsSource="{Binding Blocks}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DayLabel}" Foreground="{DynamicResource NekoMutedTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding TimeLabel}" Foreground="{DynamicResource NekoSpiritPurpleBrush}"/><TextBlock Grid.Column="2" Text="{Binding Title}" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="DISPLACED OR THREATENED" Foreground="{DynamicResource NekoWarningBrush}" FontWeight="Bold" Margin="0,18,0,7"/><ItemsControl ItemsSource="{Binding DisplacedCommitments}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl ItemsSource="{Binding ThreatenedCommitments}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" Foreground="{DynamicResource NekoWarningBrush}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="CONSEQUENCES" Foreground="{DynamicResource NekoAccentBrush}" FontWeight="Bold" Margin="0,18,0,7"/><ItemsControl ItemsSource="{Binding ProjectConsequences}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl ItemsSource="{Binding StakeholderActions}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="ASSUMPTIONS &amp; EVIDENCE" Foreground="{DynamicResource NekoAccentBrush}" FontWeight="Bold" Margin="0,18,0,7"/><ItemsControl ItemsSource="{Binding Assumptions}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=ASSUMPTION · {0}}" Foreground="{DynamicResource NekoMutedTextBrush}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl ItemsSource="{Binding Evidence}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=EVIDENCE · {0}}" Foreground="{DynamicResource NekoMutedTextBrush}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></ScrollViewer></Border>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,14,0,0"><TextBlock Text="{Binding DecisionSimulationStatus}" Foreground="{DynamicResource NekoMutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="CLOSE" Click="Close_Click" Padding="15,8" Margin="8,0"/><Button Content="PREPARE SELECTED PLAN FOR REVIEW" Click="Prepare_Click" Background="{DynamicResource NekoSpiritPurpleBrush}" Padding="17,8"/></StackPanel></DockPanel>
    </Grid>
</Window>
