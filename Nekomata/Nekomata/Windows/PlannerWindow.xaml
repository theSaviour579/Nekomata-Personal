<Window x:Class="Nekomata.UI.Windows.PlannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guardian · planner" Width="1320" Height="860" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource NekoBackgroundBrush}"
        TextElement.Foreground="{DynamicResource NekoTextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="PLANNER" Style="{DynamicResource NekoTitleText}"/>
            <TextBlock Text="Recurring duties, your objectives, and where your time goes. Edit in place; Save keeps it."
                       Foreground="{DynamicResource NekoMutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="DUTIES">
                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="ADD DUTY" Command="{Binding AddDutyCommand}" Margin="0,0,8,0"/>
                        <Button Content="DONE TODAY" Command="{Binding DutyDoneCommand}" Margin="0,0,8,0"/>
                        <Button Content="REMOVE" Command="{Binding RemoveDutyCommand}"/>
                        <TextBlock Text="Frequency: weekly (Day 1=Mon..7=Sun) · monthly (Day; 31 = month end) · quarterly (Day, Month 1-3 of the quarter) · yearly (Month, Day) · days (Every days)."
                                   Foreground="{DynamicResource NekoMutedTextBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="16,0,0,0" MaxWidth="760"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Duties}" SelectedItem="{Binding SelectedDuty}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="ON" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                            <DataGridTextColumn Header="DUTY" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="2*"/>
                            <DataGridComboBoxColumn Header="FREQUENCY" SelectedItemBinding="{Binding Frequency}" Width="100">
                                <DataGridComboBoxColumn.ElementStyle><Style TargetType="ComboBox"><Setter Property="ItemsSource" Value="{Binding DataContext.Frequencies, RelativeSource={RelativeSource AncestorType=Window}}"/></Style></DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle><Style TargetType="ComboBox"><Setter Property="ItemsSource" Value="{Binding DataContext.Frequencies, RelativeSource={RelativeSource AncestorType=Window}}"/></Style></DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn Header="DAY" Binding="{Binding Day}" Width="50"/>
                            <DataGridTextColumn Header="MONTH" Binding="{Binding Month}" Width="60"/>
                            <DataGridTextColumn Header="EVERY DAYS" Binding="{Binding EveryDays}" Width="80"/>
                            <DataGridTextColumn Header="WARN DAYS" Binding="{Binding LeadDays}" Width="80"/>
                            <DataGridTextColumn Header="LAST DONE" Binding="{Binding LastDoneText, Mode=OneWay}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="NEXT DUE" Binding="{Binding NextDueText, Mode=OneWay}" IsReadOnly="True" Width="130"/>
                            <DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="OBJECTIVES">
                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="ADD OBJECTIVE" Command="{Binding AddObjectiveCommand}" Margin="0,0,8,0"/>
                        <Button Content="LINK RECENT WORK NOW" Command="{Binding LinkObjectivesCommand}" Margin="0,0,8,0"/>
                        <Button Content="EVIDENCE TO WORD" Command="{Binding ExportObjectivesCommand}" Margin="0,0,8,0"/>
                        <Button Content="REMOVE" Command="{Binding RemoveObjectiveCommand}"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="Each afternoon Guardian links finished tasks, completed projects and duties to the objective they count towards."
                               Foreground="{DynamicResource NekoMutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <DataGrid ItemsSource="{Binding Objectives}" SelectedItem="{Binding SelectedObjective}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding Active, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                            <DataGridTextColumn Header="OBJECTIVE" Binding="{Binding Title}" Width="2*"/>
                            <DataGridTextColumn Header="MEASURED BY" Binding="{Binding Measure}" Width="1.5*"/>
                            <DataGridTextColumn Header="DUE" Binding="{Binding DueText}" Width="100"/>
                            <DataGridTextColumn Header="PROGRESS %" Binding="{Binding Progress}" Width="85"/>
                            <DataGridTextColumn Header="EVIDENCE" Binding="{Binding EvidenceText, Mode=OneWay}" IsReadOnly="True" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="TIME">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding TimeHeadline}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="Only the kind of work and the minutes are kept, never window titles or content. Reactive = email, Teams chat and calls; planned = focus blocks, projects and documents."
                                   Foreground="{DynamicResource NekoMutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <UniformGrid Columns="3">
                            <Border Background="{DynamicResource NekoSurfaceAltBrush}" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                                <TextBlock Text="{Binding TimeToday}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"/>
                            </Border>
                            <Border Background="{DynamicResource NekoSurfaceAltBrush}" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                                <TextBlock Text="{Binding TimeWeek}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"/>
                            </Border>
                            <Border Background="{DynamicResource NekoSurfaceAltBrush}" CornerRadius="10" Padding="14">
                                <TextBlock Text="{Binding TimeLastWeek}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"/>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="SAVE" Command="{Binding SaveAllCommand}" Background="{DynamicResource NekoSpiritPurpleBrush}"/>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource NekoMutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
