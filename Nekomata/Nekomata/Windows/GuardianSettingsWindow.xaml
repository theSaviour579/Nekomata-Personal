<Window x:Class="Nekomata.UI.Windows.GuardianSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guardian · settings" Width="820" Height="900" MinWidth="640" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource NekoBackgroundBrush}"
        TextElement.Foreground="{DynamicResource NekoTextBrush}">
    <Grid Margin="26,22,26,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="GUARDIAN" Style="{DynamicResource NekoSectionTitleText}"/>
            <TextBlock Text="SETTINGS" Style="{DynamicResource NekoHeadingText}" FontSize="29" Margin="0,4,0,0"/>
            <TextBlock Text="Hours, what Guardian does on its own, who counts as a manager, thresholds and Microsoft accounts. Changes apply when you save."
                       Foreground="{DynamicResource NekoMutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- Hours -->
                <Border Background="{DynamicResource NekoSurfaceAltBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="WORKING HOURS" Style="{DynamicResource NekoSectionTitleText}"/>
                        <Grid Margin="0,8,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/><ColumnDefinition Width="22"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Start" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding WorkStart, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="3" Text="End" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="4" Text="{Binding WorkEnd, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <CheckBox IsChecked="{Binding OffHoursEnabled}" Content="Off duty outside these hours, at weekends and on bank holidays (only something critical or a manager gets through)"/>
                    </StackPanel>
                </Border>

                <!-- Features -->
                <Border Background="{DynamicResource NekoSurfaceAltBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="WHAT GUARDIAN DOES ON ITS OWN" Style="{DynamicResource NekoSectionTitleText}"/>
                        <TextBlock Text="Turning one off stops it running in the background; you can still ask for it." Foreground="{DynamicResource NekoMutedTextBrush}" FontSize="11" Margin="0,4,0,8"/>
                        <ItemsControl ItemsSource="{Binding Features}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource NekoMutedTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Teams -->
                <Border Background="{DynamicResource NekoSurfaceAltBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="TEAMS" Style="{DynamicResource NekoSectionTitleText}"/>
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource NekoMutedTextBrush}" TextWrapping="Wrap">
                            <Run Text="Line manager from the directory:"/> <Run Text="{Binding LineManager, Mode=OneWay}" Foreground="{DynamicResource NekoTextBrush}"/>
                        </TextBlock>
                        <TextBlock Text="Also treat as managers (comma-separated)" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding Managers, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Never treat as managers" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding NotManagers, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0"><Run Text="{Binding MutedChatCount, Mode=OneWay}"/><Run Text=" muted chat(s)"/></TextBlock>
                            <Button Content="UNMUTE ALL" Command="{Binding ClearMutedCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Thresholds -->
                <Border Background="{DynamicResource NekoSurfaceAltBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="THRESHOLDS" Style="{DynamicResource NekoSectionTitleText}"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="A project has gone quiet after this many days without movement" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding ProjectQuietDays, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Text="Hours of meetings a week before I suggest trimming (0 = off)" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MeetingBudgetHours, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Weather -->
                <Border Background="{DynamicResource NekoSurfaceAltBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="WEATHER" Style="{DynamicResource NekoSectionTitleText}"/>
                        <TextBlock Text="Town or postcode for the Home weather. Leave blank to use your approximate location from your internet connection." Foreground="{DynamicResource NekoMutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,6"/>
                        <TextBox Text="{Binding WeatherLocation, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <!-- Accounts -->
                <Border Background="{DynamicResource NekoSurfaceAltBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="MICROSOFT ACCOUNTS &amp; PERMISSIONS" Style="{DynamicResource NekoSectionTitleText}"/>
                        <TextBlock Text="The everyday account is used for mail, calendar and Teams. Meeting transcripts can be granted from the same account or another one."
                                   Foreground="{DynamicResource NekoMutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <TextBlock Text="{Binding AccountsStatus}" Foreground="{DynamicResource NekoMutedTextBrush}" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding Accounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource NekoBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Role}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}"/>
                                                <TextBlock Text="{Binding Username}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Permissions}" Foreground="{DynamicResource NekoMutedTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="MAKE EVERYDAY" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.MakePrimaryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <Button Content="SIGN OUT"
                                                        Command="{Binding DataContext.SignOutCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="SIGN IN AGAIN" Command="{Binding AccountCommand}" CommandParameter="everyday" Margin="0,0,6,6"/>
                            <Button Content="ADD AN ACCOUNT" Command="{Binding AccountCommand}" CommandParameter="add" Margin="0,0,6,6"/>
                            <Button Content="GRANT TRANSCRIPTS" Command="{Binding AccountCommand}" CommandParameter="transcripts" Margin="0,0,6,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource NekoMutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="SAVE" Command="{Binding SaveCommand}" Background="{DynamicResource NekoSpiritPurpleBrush}" Margin="0,0,8,0"/>
                <Button Content="CLOSE" Command="{Binding CloseCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
