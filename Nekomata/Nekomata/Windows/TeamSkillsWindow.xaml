<Window x:Class="Nekomata.UI.Windows.TeamSkillsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Guardian Team" Width="1150" Height="760" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterOwner" Background="{DynamicResource NekoBackgroundBrush}">
 <Window.Resources>
  <Style x:Key="TeamGridHeader" TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource NekoSurfaceAltBrush}"/><Setter Property="Foreground" Value="{DynamicResource NekoAccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource NekoBorderSoftBrush}"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style x:Key="TeamGridCell" TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource NekoBorderSoftBrush}"/><Setter Property="Padding" Value="8,5"/></Style>
  <Style x:Key="TeamGridRow" TargetType="DataGridRow"><Setter Property="Background" Value="{DynamicResource NekoSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}"/><Setter Property="MinHeight" Value="34"/><Style.Triggers><Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="{DynamicResource NekoSurfaceAltBrush}"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="TEAM SKILLS &amp; AVAILABILITY" Style="{DynamicResource NekoTitleText}"/><TextBlock Text="Build editable capability profiles from relevant Microsoft 365 colleagues and their job titles." Style="{DynamicResource NekoMutedText}"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="SYNC MICROSOFT 365" Command="{Binding SyncMicrosoft365Command}" Margin="0,0,8,0"/><Button Content="+ ADD MEMBER" Command="{Binding AddMemberCommand}"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource NekoSurfaceBrush}" BorderBrush="{DynamicResource NekoBorderSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="10"><ListBox ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5,8"><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Text="{Binding Role}" Foreground="{DynamicResource NekoMutedTextBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding SourceLabel}" Foreground="{DynamicResource NekoAccentBrush}" FontSize="10"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Background="{DynamicResource NekoSurfaceBrush}" BorderBrush="{DynamicResource NekoBorderSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,14"><StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="NAME" Style="{DynamicResource NekoSectionTitleText}"/><TextBox Text="{Binding SelectedMember.Name}" Margin="0,6,0,12"/><TextBlock Text="EMAIL" Style="{DynamicResource NekoSectionTitleText}"/><TextBox Text="{Binding SelectedMember.Email}" Margin="0,6,0,12"/><TextBlock Text="ROLE / JOB TITLE" Style="{DynamicResource NekoSectionTitleText}"/><TextBox Text="{Binding SelectedMember.Role}" Margin="0,6,0,0"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="AVAILABILITY" Style="{DynamicResource NekoSectionTitleText}"/><ComboBox ItemsSource="{Binding AvailabilityOptions}" SelectedItem="{Binding SelectedMember.AvailabilityStatus}" Margin="0,6,0,12" Height="38" Padding="10,5"/><TextBlock Text="CAPACITY %" Style="{DynamicResource NekoSectionTitleText}"/><TextBox Text="{Binding SelectedMember.CapacityPercent}" Margin="0,6,0,12"/><TextBlock Text="UNAVAILABLE UNTIL" Style="{DynamicResource NekoSectionTitleText}"/><DatePicker SelectedDate="{Binding SelectedMember.UnavailableUntil}" Height="38" Margin="0,6,0,0"/></StackPanel>
     </Grid>
     <TextBlock Text="PRIMARY RESPONSIBILITIES" Style="{DynamicResource NekoSectionTitleText}" Margin="0,14,0,0"/><TextBox Text="{Binding SelectedMember.Responsibilities}" Height="70" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,12"/>
     <TextBlock Text="EXCLUSIONS — WORK THIS PERSON SHOULD NOT RECEIVE" Style="{DynamicResource NekoSectionTitleText}"/><TextBox Text="{Binding SelectedMember.Exclusions}" Height="60" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel></Border>
    <Border Background="{DynamicResource NekoSurfaceBrush}" BorderBrush="{DynamicResource NekoBorderSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="18"><StackPanel>
     <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ROLE SKILLS" Style="{DynamicResource NekoSectionTitleText}"/><TextBlock Text="1 Awareness · 2 Working · 3 Advanced · 4 Expert" Foreground="{DynamicResource NekoMutedTextBrush}" FontSize="10"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="SUGGEST FROM ROLE" Command="{Binding SuggestRoleSkillsCommand}" Margin="0,0,8,0"/><Button Content="+ ADD SKILL" Command="{Binding AddSkillCommand}" Margin="0,0,8,0"/><Button Content="REMOVE" Command="{Binding RemoveSkillCommand}"/></StackPanel></Grid>
     <DataGrid ItemsSource="{Binding Skills}" SelectedItem="{Binding SelectedSkill}" AutoGenerateColumns="False" CanUserAddRows="False" Height="230" Background="{DynamicResource NekoSurfaceBrush}" Foreground="{DynamicResource NekoTextBrush}" BorderBrush="{DynamicResource NekoBorderSoftBrush}" HeadersVisibility="Column" GridLinesVisibility="All" AlternationCount="2" RowStyle="{StaticResource TeamGridRow}" CellStyle="{StaticResource TeamGridCell}" ColumnHeaderStyle="{StaticResource TeamGridHeader}"><DataGrid.Columns><DataGridTextColumn Header="SKILL" Binding="{Binding Name}" Width="190"/><DataGridTextColumn Header="RECOGNITION TERMS" Binding="{Binding Aliases}" Width="*"/><DataGridTextColumn Header="LEVEL 1–4" Binding="{Binding Proficiency}" Width="100"/><DataGridCheckBoxColumn Header="PRIMARY" Binding="{Binding IsPrimary}" Width="80"/></DataGrid.Columns></DataGrid>
    </StackPanel></Border>
   </StackPanel></ScrollViewer>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource NekoMutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Content="SAVE PROFILE" Command="{Binding SaveCommand}" DockPanel.Dock="Right" Width="150"/></DockPanel>
 </Grid>
</Window>
