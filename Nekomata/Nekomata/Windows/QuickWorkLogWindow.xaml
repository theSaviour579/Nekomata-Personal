<Window x:Class="Nekomata.UI.Windows.QuickWorkLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log completed work" Width="640" Height="590" MinWidth="520" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource NekoBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="LOG COMPLETED WORK" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}"/>
            <TextBlock Text="Capture work completed today. Use approximate timings if needed; this is your retrospective record, not an inferred timesheet."
                       Margin="0,8,0,18" Foreground="{DynamicResource NekoMutedTextBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="OBJECTIVE / WORK DONE" Foreground="{DynamicResource NekoAccentBrush}"/>
            <TextBox Text="{Binding AdHocObjectiveTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,16" Padding="10"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="START TODAY (24-HOUR HH:mm)" Foreground="{DynamicResource NekoAccentBrush}"/>
                    <TextBox Text="{Binding QuickWorkStart, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,16" Padding="10"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="DURATION (WHOLE MINUTES)" Foreground="{DynamicResource NekoAccentBrush}"/>
                    <TextBox Text="{Binding QuickWorkDuration, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,16" Padding="10"/></StackPanel>
            </Grid>
            <TextBlock Text="OUTCOME / NOTES (OPTIONAL)" Foreground="{DynamicResource NekoAccentBrush}"/>
            <TextBox Text="{Binding AdHocObjectiveOutcome, UpdateSourceTrigger=PropertyChanged}" Height="100" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,16" Padding="10"/>
            <TextBlock Text="Save adds a completed work session to the daily digest and attempts a calendar entry. Existing calendar events are not moved or replaced."
                       Foreground="{DynamicResource NekoMutedTextBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding AdHocObjectiveStatus}" Margin="0,12,0,12" Foreground="{DynamicResource NekoAccentBrush}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CLOSE" IsCancel="True" Margin="0,0,10,0"/>
                <Button Content="SAVE WORK LOG" Command="{Binding SaveQuickWorkLogCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
