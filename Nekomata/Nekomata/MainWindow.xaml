<Window x:Class="Nekomata.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Nekomata.UI.Views"
        xmlns:guardian="clr-namespace:Nekomata.UI.Controls.Guardian"
        xmlns:common="clr-namespace:Nekomata.UI.Controls.Common"
        Title="Nekomata Personal"
        Width="1200"
        Height="900"
        MinWidth="900"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource NekoBackgroundBrush}"
        Icon="/Assets/Images/App.ico">
    <Window.InputBindings>
        <KeyBinding Key="F8" Command="{Binding OpenInterruptionCommand}"/>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenCommandPaletteCommand}"/>
        <KeyBinding Key="Space" Modifiers="Control+Shift" Command="{Binding OpenQuickCaptureCommand}"/>
        <KeyBinding Key="Space" Modifiers="Control+Alt" Command="{Binding TalkToGuardianCommand}"/>
        <KeyBinding Key="H" Modifiers="Control+Alt" Command="{Binding ToggleHudCommand}"/>
    </Window.InputBindings>
    <Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="88"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.Resources>
        <Style x:Key="NekoNavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DashboardNavButton" TargetType="Button" BasedOn="{StaticResource NekoNavButton}"><Style.Triggers><DataTrigger Binding="{Binding WorkspaceMode}" Value="Dashboard"><Setter Property="Background" Value="{DynamicResource NekoSpiritPurpleBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource NekoAccentBrush}"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="CalendarNavButton" TargetType="Button" BasedOn="{StaticResource NekoNavButton}"><Style.Triggers><DataTrigger Binding="{Binding WorkspaceMode}" Value="Calendar"><Setter Property="Background" Value="{DynamicResource NekoSpiritPurpleBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource NekoAccentBrush}"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="EmailNavButton" TargetType="Button" BasedOn="{StaticResource NekoNavButton}"><Style.Triggers><DataTrigger Binding="{Binding WorkspaceMode}" Value="Email"><Setter Property="Background" Value="{DynamicResource NekoSpiritPurpleBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource NekoAccentBrush}"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="AttentionNavButton" TargetType="Button" BasedOn="{StaticResource NekoNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasActiveAttention}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource NekoWarningBrush}"/>
                    <Setter Property="Background" Value="#332A1A"/>
                    <Setter Property="Effect">
                        <Setter.Value><DropShadowEffect Color="#FFC857" BlurRadius="22" ShadowDepth="0" Opacity="0.95"/></Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding WorkspaceMode}" Value="Attention">
                    <Setter Property="Background" Value="{DynamicResource NekoSpiritPurpleBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource NekoWarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ValueNavButton" TargetType="Button" BasedOn="{StaticResource NekoNavButton}"><Style.Triggers><DataTrigger Binding="{Binding WorkspaceMode}" Value="ValueLeverage"><Setter Property="Background" Value="{DynamicResource NekoSpiritPurpleBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource NekoAccentBrush}"/></DataTrigger></Style.Triggers></Style>
    </Grid.Resources>
    <Border Grid.Column="0" Margin="12,16,0,16" CornerRadius="22" Background="{DynamicResource NekoSurfaceBrush}" BorderBrush="{DynamicResource NekoBorderBrush}" BorderThickness="1">
        <Grid Margin="8,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Width="46" Height="46" CornerRadius="15" Background="{DynamicResource NekoHeaderGradientBrush}" BorderBrush="{DynamicResource NekoSpiritPurpleBrush}" BorderThickness="1" ToolTip="Nekomata Personal"><TextBlock Text="猫" Foreground="{DynamicResource NekoAccentBrush}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,18,0,8"><StackPanel HorizontalAlignment="Center">
                <Button Style="{StaticResource DashboardNavButton}" Command="{Binding ShowDashboardCommand}" ToolTip="Dashboard"><StackPanel><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="HOME" FontSize="8" Margin="0,3,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource NekoNavButton}" Command="{Binding ShowMorningPreflightCommand}" ToolTip="Morning pre-flight"><StackPanel><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="START" FontSize="8" Margin="0,3,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource CalendarNavButton}" Command="{Binding ShowCalendarCommand}" ToolTip="Calendar"><StackPanel><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="PLAN" FontSize="8" Margin="0,3,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource NekoNavButton}" Command="{Binding ShowDecisionSimulatorCommand}" ToolTip="Compare plans and consequences"><StackPanel><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="WHAT IF" FontSize="8" Margin="0,3,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource EmailNavButton}" Command="{Binding ShowEmailCommand}" ToolTip="Email"><StackPanel><TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="MAIL" FontSize="8" Margin="0,3,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource AttentionNavButton}" Command="{Binding ShowAttentionCommand}" ToolTip="Items requiring your judgement"><StackPanel><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasActiveAttention}" Value="True"><Setter Property="Foreground" Value="{DynamicResource NekoWarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding ActiveAttentionCount, StringFormat=ASK {0}}" FontSize="8" Margin="0,3,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource NekoNavButton}" Command="{Binding OpenGuardianPlannerCommand}" ToolTip="Meeting analyser"><StackPanel><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="MEET" FontSize="8" Margin="0,3,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource NekoNavButton}" Command="{Binding OpenTeamSkillsCommand}" ToolTip="Direct reports, skills and availability"><StackPanel><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="TEAM" FontSize="8" Margin="0,3,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource NekoNavButton}" Command="{Binding OpenQuickWorkLogCommand}" ToolTip="Log work"><StackPanel><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="LOG" FontSize="8" Margin="0,3,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource NekoNavButton}" Command="{Binding OpenQuickCaptureCommand}" ToolTip="Quick capture: a task, note or idea"><StackPanel><TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="NOTE" FontSize="8" Margin="0,3,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource NekoNavButton}" Command="{Binding ShowDayReviewCommand}" ToolTip="Daily wrap-up"><StackPanel><TextBlock Text="&#xE73A;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="WRAP" FontSize="8" Margin="0,3,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource ValueNavButton}" Command="{Binding ShowValueLeverageCommand}" ToolTip="Value and role goals"><StackPanel><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="VALUE" FontSize="8" Margin="0,3,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource NekoNavButton}" Command="{Binding ShowDecisionLearningCommand}" ToolTip="Decision learning"><StackPanel><TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="LEARN" FontSize="8" Margin="0,3,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource NekoNavButton}" Command="{Binding OpenGuardianActivityCommand}" ToolTip="Guardian activity"><StackPanel><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="AUDIT" FontSize="8" Margin="0,3,0,0"/></StackPanel></Button>
            </StackPanel></ScrollViewer>
            <Button Grid.Row="2" Content="CTRL+K" Click="QuickMenu_Click" Padding="5,3" FontSize="8" HorizontalAlignment="Center" ToolTip="Open quick menu"/>
        </Grid>
    </Border>
    <ScrollViewer
        Grid.Column="1"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="18,16,20,20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ====================================================== -->
            <!-- HEADER -->
            <!-- ====================================================== -->

            <Border Grid.Row="0"
                CornerRadius="22"
                Padding="22"
                Background="{DynamicResource NekoHeaderGradientBrush}"
                BorderBrush="{DynamicResource NekoBorderBrush}"
                BorderThickness="1"
                Visibility="{Binding ShowHudChrome, Converter={StaticResource InverseBoolVis}}"
                Margin="0,0,0,16">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">

                        <common:GuardianPresenceOrb State="{Binding GuardianPresenceState}"
                                                    Width="60" Height="60"
                                                    Margin="0,0,16,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{Binding GuardianPresenceState}"/>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="Your personal planning assistant"
                                   Foreground="{DynamicResource NekoSpiritPurpleBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                            <TextBlock Text="{Binding Greeting}"
                                   Style="{DynamicResource NekoMutedText}"
                                   Margin="0,6,0,0"/>

                            <!-- What Guardian is thinking about right now; hover for the recent history. -->
                            <TextBlock Margin="0,6,0,0"
                                   MaxWidth="720"
                                   FontSize="12"
                                   FontStyle="Italic"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource NekoAccentBrush}"
                                   ToolTip="{Binding GuardianThoughtHistory}">
                                <Run Text="◆ " FontStyle="Normal"/><Run Text="{Binding GuardianThought, Mode=OneWay}"/>
                            </TextBlock>

                        </StackPanel>

                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentDateTime,
                                             StringFormat={}{0:HH:mm}}"
                               Foreground="{DynamicResource NekoSpiritWhiteBrush}"
                               FontSize="42"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>

                        <TextBlock Text="{Binding CurrentDateTime,
                                             StringFormat={}{0:dddd dd MMM}}"
                               Style="{DynamicResource NekoMutedText}"
                               HorizontalAlignment="Right"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,0,0">

                            <Button Content="UPDATE AVAILABLE"
                                    Command="{Binding InstallLatestUpdateCommand}"
                                    Foreground="{DynamicResource NekoWarningBrush}"
                                    BorderBrush="{DynamicResource NekoWarningBrush}"
                                    Padding="10,4"
                                    Margin="0,0,10,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding UpdateAvailable}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                                                        <Button Content="{Binding GuardianVoiceButtonLabel}"
                                    Command="{Binding ToggleGuardianVoiceCommand}"
                                    Padding="10,4"
                                    Margin="0,0,10,0"
                                    ToolTip="Enable or mute Guardian spoken briefings"/>
                            <Button Content="{Binding DiagnosticStatusButtonLabel}"
                                    Command="{Binding ShowDiagnosticsCommand}"
                                    ToolTip="{Binding DiagnosticStatusButtonToolTip}"
                                    Padding="10,4"
                                    Margin="0,0,10,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Foreground" Value="{DynamicResource NekoSuccessBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource NekoSuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDiagnosticIssues}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource NekoWarningBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource NekoWarningBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DiagnosticsBusy}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource NekoAccentBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource NekoAccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                        </StackPanel>

                    </StackPanel>

                    <Button Grid.Row="1" Grid.ColumnSpan="2" Command="{Binding ShowSituationCommand}"
                            HorizontalContentAlignment="Stretch" Padding="12,8" Margin="0,14,0,0"
                            ToolTip="Open Guardian's current evidence and operating context">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <!-- The new home page shows all of this itself; the ticker stays on the other pages. -->
                                    <DataTrigger Binding="{Binding ShowModernHome}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="LIVE" Foreground="{DynamicResource NekoSuccessBrush}" FontWeight="Bold" Margin="0,0,12,0"/>
                            <TextBlock DockPanel.Dock="Right" Text="DETAILS  ›" Foreground="{DynamicResource NekoAccentBrush}" FontWeight="SemiBold" Margin="12,0,0,0"/>
                            <TextBlock Text="{Binding SituationStripText}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource NekoTextBrush}"/>
                        </DockPanel>
                    </Button>

                </Grid>

            </Border>


            <!-- ====================================================== -->
            <!-- GUARDIAN CONVERSATION -->
            <!-- ====================================================== -->

            <Border Grid.Row="1"
                Margin="0,0,0,14"
                Background="{DynamicResource NekoCardGradientBrush}"
                BorderBrush="{DynamicResource NekoSpiritPurpleBrush}"
                BorderThickness="1"
                CornerRadius="18"
                MaxHeight="460">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GuardianPanelExpanded}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <!-- The new home page shows the conversation under its Ask box instead. -->
                            <DataTrigger Binding="{Binding ShowModernHome}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Expander IsExpanded="{Binding GuardianPanelExpanded,
                                           Mode=TwoWay}"
                      Background="Transparent">

                    <Expander.Header>

                        <Grid Margin="14,10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="{Binding GuardianPanelTitle}"
                                       Style="{DynamicResource NekoSectionTitleText}"
                                       VerticalAlignment="Center"/>

                                <TextBlock Text="  ●"
                                       Foreground="{DynamicResource NekoSuccessBrush}"
                                       VerticalAlignment="Center"/>

                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                   Text="Expand / collapse"
                                   Style="{DynamicResource NekoTinyText}"
                                   VerticalAlignment="Center"/>

                        </Grid>

                    </Expander.Header>

                    <Grid Margin="16,0,16,16">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="GuardianScrollViewer"
                                  Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="360">

                            <ItemsControl ItemsSource="{Binding ChatHistory}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Grid Margin="0,0,0,10">

                                            <Border x:Name="MessageBubble"
                                                Background="{DynamicResource NekoSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource NekoBorderSoftBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="14"
                                                MaxWidth="680"
                                                HorizontalAlignment="Left">

                                                <StackPanel>

                                                    <DockPanel>

                                                        <TextBlock Text="{Binding DisplayRole}"
                                                               Style="{DynamicResource NekoSectionTitleText}"
                                                               DockPanel.Dock="Left"/>

                                                        <TextBlock Text="{Binding CreatedAt,
                                                                             StringFormat={}{0:HH:mm}}"
                                                               Style="{DynamicResource NekoTinyText}"
                                                               DockPanel.Dock="Right"
                                                               HorizontalAlignment="Right"/>

                                                    </DockPanel>

                                                    <TextBox
    Text="{Binding Content}"
    IsReadOnly="True"
    TextWrapping="Wrap"
    BorderThickness="0"
    Background="Transparent"
    Foreground="{DynamicResource NekoTextBrush}"
    CaretBrush="{DynamicResource NekoTextBrush}"
    AcceptsReturn="True"
    VerticalScrollBarVisibility="Disabled"
    HorizontalScrollBarVisibility="Disabled"/>

                                                    <TextBlock Text="{Binding AttachmentLabel}"
                                                               Foreground="{DynamicResource NekoAccentBrush}"
                                                               FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasAttachments}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                </StackPanel>

                                            </Border>

                                        </Grid>

                                        <DataTemplate.Triggers>

                                            <DataTrigger Binding="{Binding IsUser}"
                                                     Value="True">

                                                <Setter TargetName="MessageBubble"
                                                    Property="HorizontalAlignment"
                                                    Value="Right"/>

                                                <Setter TargetName="MessageBubble"
                                                    Property="Background"
                                                    Value="{DynamicResource NekoSpiritPurpleBrush}"/>

                                                <Setter TargetName="MessageBubble"
                                                    Property="BorderBrush"
                                                    Value="{DynamicResource NekoSpiritPurpleBrush}"/>

                                            </DataTrigger>

                                        </DataTemplate.Triggers>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                        <TextBlock Grid.Row="1"
                               Text="Guardian is analysing your workspace..."
                               Margin="0,8,0,0">

                            <TextBlock.Style>

                                <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource NekoMutedText}">

                                    <Setter Property="Visibility"
                                        Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding GuardianBusy}"
                                                 Value="True">

                                            <Setter Property="Visibility"
                                                Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>

                    </Grid>

                </Expander>

            </Border>
            <!-- ====================================================== -->
            <!-- GUARDIAN PROPOSAL PANEL -->
            <!-- ====================================================== -->

            <guardian:GuardianProposalPanel
            Grid.Row="3"
            Margin="0,0,0,14"
            Proposal="{Binding PendingGuardianAction}"
            ProjectName="{Binding PendingGuardianProject.Name}"
            DismissCommand="{Binding DismissGuardianProposalCommand}"
            RegenerateCommand="{Binding RegenerateGuardianProposalCommand}"
            RemoveItemCommand="{Binding RemoveGuardianProposalItemCommand}"
            ReplaceItemCommand="{Binding ReplaceGuardianProposalItemCommand}"
            RestoreItemCommand="{Binding RestoreGuardianProposalItemCommand}"
            CreateTasksCommand="{Binding CreateSelectedTasksCommand}">

                <guardian:GuardianProposalPanel.Style>

                    <Style TargetType="guardian:GuardianProposalPanel">

                        <Setter Property="Visibility"
                            Value="Collapsed"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding GuardianProposalVisible}"
                                     Value="True">

                                <Setter Property="Visibility"
                                    Value="Visible"/>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </guardian:GuardianProposalPanel.Style>

            </guardian:GuardianProposalPanel>

            <!-- ====================================================== -->
            <!-- DASHBOARD / MISSION -->
            <!-- ====================================================== -->

            <Grid Grid.Row="4"
              Margin="0,4,0,0">

                <Grid Visibility="{Binding WorkspaceMode,
                                     Converter={StaticResource DashboardVisibilityConverter}}">
                    <!-- The Guardian HUD home page. -->
                    <views:HomeView/>
                </Grid>

                <views:MissionView
                Visibility="{Binding WorkspaceMode,
                                     Converter={StaticResource MissionVisibilityConverter}}"/>

                <views:CalendarView
                Visibility="{Binding WorkspaceMode,
                                     Converter={StaticResource CalendarVisibilityConverter}}"/>
                <views:EmailView
                Visibility="{Binding WorkspaceMode,
                                     Converter={StaticResource EmailVisibilityConverter}}"/>
                <views:AttentionView
                Visibility="{Binding WorkspaceMode,
                                     Converter={StaticResource AttentionVisibilityConverter}}"/>

                <views:SettingsView
                Visibility="{Binding WorkspaceMode,
                                     Converter={StaticResource DiagnosticsVisibilityConverter}}"/>
                <views:AnalyticsView Visibility="{Binding WorkspaceMode, Converter={StaticResource ValueLeverageVisibilityConverter}}"/>

                <views:AnalyticsView
                Visibility="{Binding WorkspaceMode,
                                     Converter={StaticResource ValueLeverageVisibilityConverter}}"/>

            </Grid>

        </Grid>
    </ScrollViewer>

        <Border Grid.ColumnSpan="2" Panel.ZIndex="980" Background="#D90A111B" Padding="30">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CommandPaletteVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                     Background="{DynamicResource NekoCardGradientBrush}" BorderBrush="{DynamicResource NekoSpiritPurpleBrush}" BorderThickness="1" CornerRadius="20" Padding="22">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="720"/><Setter Property="Margin" Value="0,90,0,0"/><Setter Property="MaxHeight" Value="650"/>
                        <Style.Triggers><DataTrigger Binding="{Binding CommandPaletteCompact}" Value="True"><Setter Property="Width" Value="560"/><Setter Property="Margin" Value="0,24,0,0"/><Setter Property="MaxHeight" Value="430"/></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel><TextBlock Text="GUARDIAN CAPTURE / SEARCH" Foreground="{DynamicResource NekoAccentBrush}" FontWeight="Bold"/><TextBlock DockPanel.Dock="Right" Text="CTRL+SHIFT+SPACE · ESC" Foreground="{DynamicResource NekoMutedTextBrush}" FontSize="11"/></DockPanel>
                    <Grid Margin="0,12,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="CommandPaletteTextBox" Text="{Binding CommandPaletteInput, UpdateSourceTrigger=PropertyChanged}" FontSize="22" Padding="14">
                            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ExecuteCommandPaletteCommand}"/><KeyBinding Key="Escape" Command="{Binding CloseCommandPaletteCommand}"/></TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="MIC" Command="{Binding DictateCommandPaletteCommand}" Margin="8,0,0,0" MinWidth="62" ToolTip="Speak a command, answer or search"/>
                    </Grid>
                    <TextBlock Text="{Binding CommandPaletteStatus}" Foreground="{DynamicResource NekoMutedTextBrush}" FontSize="12" Margin="2,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding CommandPaletteSuggestions}">
                        <ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.RunPaletteSuggestionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Margin="0,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Command}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="{DynamicResource NekoMutedTextBrush}" TextWrapping="Wrap" Margin="18,0,0,0"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.ColumnSpan="2" Panel.ZIndex="985" Background="#E60A111B" Padding="30">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RecoveryPlanVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <Border Width="650" MaxHeight="740" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource NekoCardGradientBrush}" BorderBrush="{DynamicResource NekoWarningBrush}" BorderThickness="1" CornerRadius="24" Padding="26" TextElement.Foreground="{DynamicResource NekoTextBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="PLAN IMPACT DETECTED" Foreground="{DynamicResource NekoWarningBrush}" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="{Binding RecoveryPlan.ImpactSummary}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,20"/>
                    <Border Background="{DynamicResource NekoSurfaceAltBrush}" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="RECOMMENDED RECOVERY" Foreground="{DynamicResource NekoAccentBrush}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding RecoveryPlan.RecoverySummary}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            <TextBlock Text="{Binding RecoveryPlan.ExpectedFinishSummary}" Foreground="{DynamicResource NekoSuccessBrush}" FontWeight="Bold" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding RecoveryPlan.PreservedCommitments}" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=Preserve · {0}}" Foreground="{DynamicResource NekoMutedTextBrush}" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="Guardian will apply this through the audited action pipeline. Protected meetings are not moved; conflict-aware undo remains available in Activity." Foreground="{DynamicResource NekoMutedTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,16,0,0"/>
                    <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                        <Button Content="NOT NOW" Command="{Binding DismissRecoveryPlanCommand}" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="APPLY RECOVERY PLAN" Command="{Binding ApplyRecoveryPlanCommand}" Background="{DynamicResource NekoSpiritPurpleBrush}" Margin="6,0,0,0"/>
                    </Grid>
                </StackPanel></ScrollViewer>
            </Border>
        </Border>

        <Border Grid.ColumnSpan="2" Panel.ZIndex="990" Background="#E60A111B" Padding="30">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DayReviewVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <Border Width="650" MaxHeight="760" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource NekoCardGradientBrush}" BorderBrush="{DynamicResource NekoSpiritPurpleBrush}"
                    BorderThickness="1" CornerRadius="24" Padding="26"
                    TextElement.Foreground="{DynamicResource NekoTextBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="GUARDIAN — DAILY WRAP-UP" Foreground="{DynamicResource NekoSpiritPurpleBrush}" FontSize="13" FontWeight="Bold"/>
                        <Expander Header="AUTOMATICALLY RECONCILED TODAY" Margin="0,12,0,12">
                            <TextBlock Text="{Binding ReconciledWorkSummary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </Expander>
                        <Border Background="{DynamicResource NekoSurfaceAltBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DAILY ACTIVITY RECONCILIATION" Foreground="{DynamicResource NekoAccentBrush}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ActivityReconciliation.CoverageLabel, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource NekoSurfaceBrush}" CornerRadius="10" Padding="12,7">
                                        <TextBlock Text="{Binding ActivityReconciliation.CoveragePercent, Mode=OneWay, StringFormat={}{0}% EVIDENCE}" Foreground="{DynamicResource NekoSuccessBrush}" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding ActivityReconciliation.Summary, Mode=OneWay}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding ActivityReconciliation.EvidenceDetail, Mode=OneWay}" Foreground="{DynamicResource NekoMutedTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding ActivityReconciliationStatus}" Foreground="{DynamicResource NekoWarningBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <ItemsControl ItemsSource="{Binding ActivityReconciliation.Gaps}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource NekoWarningBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,5,0,0">
                                                <StackPanel>
                                                    <TextBlock Foreground="{DynamicResource NekoWarningBrush}" FontWeight="Bold"><Run Text="{Binding TimeLabel, Mode=OneWay}"/><Run Text=" · REVIEW REQUIRED"/></TextBlock>
                                                    <TextBlock Text="{Binding Prompt, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource NekoMutedTextBrush}" Margin="0,4,0,8"/>
                                                    <TextBox Text="{Binding ReviewTitle, UpdateSourceTrigger=PropertyChanged}" ToolTip="What were you doing?"/>
                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Button Content="RECORD AS WORK" Command="{Binding DataContext.ConfirmActivityGapCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="2" Content="MARK NON-WORK" Command="{Binding DataContext.MarkActivityGapNonWorkCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Close today. Leave yourself a clear start tomorrow." FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,20"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding DayReview.PlannedLabel, StringFormat=Planned: {0}}"/>
                                <TextBlock Text="{Binding DayReview.CompletedLabel, StringFormat=Completed: {0}}" Margin="0,7,0,0"/>
                                <TextBlock Text="{Binding DayReview.InterruptionCount, StringFormat=Interruptions: {0}}" Margin="0,7,0,0"/>
                                <TextBlock Text="{Binding DayReview.InterruptionMinutes, StringFormat=Minutes lost: {0}}" Margin="0,7,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding DayReview.UnplannedMinutes, StringFormat=Unplanned work: {0}m}"/>
                                <TextBlock Margin="0,7,0,0"><Run Text="Focus blocks protected: "/><Run Text="{Binding DayReview.FocusBlocksProtected, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding DayReview.FocusBlocksPlanned, Mode=OneWay}"/></TextBlock>
                                <TextBlock Margin="0,7,0,0"><Run Text="Objectives completed: "/><Run Text="{Binding DayReview.ObjectivesCompleted, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding DayReview.ObjectivesPlanned, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                        </Grid>
                        <Border Background="{DynamicResource NekoSurfaceAltBrush}" CornerRadius="12" Padding="14" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ESTIMATED VALUE" Foreground="{DynamicResource NekoAccentBrush}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Analytics.BusinessValueDeliveredToday, StringFormat=£{0:N2}}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="ELAPSED WAGES" Foreground="{DynamicResource NekoWarningBrush}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Analytics.WageCostToday, StringFormat=£{0:N2}}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Analytics.HourlyLabourRate, StringFormat=£{0:N2}/hour}" Foreground="{DynamicResource NekoMutedTextBrush}" FontSize="10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="VALUE LESS WAGES" Foreground="{DynamicResource NekoSuccessBrush}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Analytics.ValueAfterWageCostToday, StringFormat=£{0:N2}}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Analytics.BusinessValueToWageCostRatio, StringFormat={}{0:N1}× wage cost}" Foreground="{DynamicResource NekoMutedTextBrush}" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="{DynamicResource NekoSurfaceAltBrush}" CornerRadius="12" Padding="14" Margin="0,12,0,0">
                            <Border.Style>
                                <Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding WeeklyOvertimeVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="WEEKLY ADDITIONAL TIME" Foreground="{DynamicResource NekoWarningBrush}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding WeeklyOvertimeSummaryText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource NekoSurfaceAltBrush}" CornerRadius="12" Padding="14" Margin="0,20,0,0">
                            <StackPanel><TextBlock Text="WHAT I LEARNED" Foreground="{DynamicResource NekoAccentBrush}" FontWeight="Bold"/><TextBlock Text="{Binding DayReview.LearnedSummary}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                        </Border>
                        <Border Background="{DynamicResource NekoSurfaceAltBrush}" CornerRadius="12" Padding="14" Margin="0,10,0,0">
                            <StackPanel><TextBlock Text="TOMORROW" Foreground="{DynamicResource NekoSuccessBrush}" FontWeight="Bold"/><TextBlock Text="{Binding DayReview.TomorrowSummary}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                        </Border>
                        <Border Background="{DynamicResource NekoSurfaceAltBrush}" CornerRadius="12" Padding="14" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="ADD WORK THAT WASN'T PLANNED" Foreground="{DynamicResource NekoAccentBrush}" FontWeight="Bold"/>
                                <TextBlock Text="Add an emergency or ad-hoc objective after it happened. It will be included in today's digest and backfilled to your calendar." TextWrapping="Wrap" Foreground="{DynamicResource NekoMutedTextBrush}" Margin="0,5,0,10"/>
                                <TextBox Text="{Binding AdHocObjectiveTitle, UpdateSourceTrigger=PropertyChanged}" ToolTip="What did you work on?"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="STARTED" FontSize="9" Foreground="{DynamicResource NekoMutedTextBrush}"/><TextBox Text="{Binding AdHocObjectiveStartedAtText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="FINISHED" FontSize="9" Foreground="{DynamicResource NekoMutedTextBrush}"/><TextBox Text="{Binding AdHocObjectiveFinishedAtText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                </Grid>
                                <TextBlock Text="Enter date and time, for example 02/09/2026 14:30." FontSize="10" Foreground="{DynamicResource NekoMutedTextBrush}" Margin="0,6,0,0"/>
                                <Button Content="ADD TO TODAY'S DIGEST" Command="{Binding AddAdHocObjectiveCommand}" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding AdHocObjectiveStatus}" TextWrapping="Wrap" Foreground="{DynamicResource NekoSuccessBrush}" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource NekoSurfaceAltBrush}" CornerRadius="12" Padding="14" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="UNFINISHED OBJECTIVES" Foreground="{DynamicResource NekoAccentBrush}" FontWeight="Bold"/>
                                <TextBlock Text="Tasks due by today or scheduled today. Choices apply to pre-flight carry-forward only; source tasks and urgent alerts remain unchanged." TextWrapping="Wrap" Margin="0,6,0,10"/>
                                <TextBlock Text="No unfinished due or scheduled tasks in the current snapshot." TextWrapping="Wrap" Foreground="{DynamicResource NekoMutedTextBrush}">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding WrapUpObjectives.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding WrapUpObjectives}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource NekoSpiritPurpleBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                    <ComboBox ItemsSource="{Binding DataContext.WrapUpDecisionOptions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Decision, Mode=TwoWay}"/>
                                                    <StackPanel Margin="0,8,0,0">
                                                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Decision}" Value="Defer until"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                        <TextBlock Text="RETURN TO PRE-FLIGHT ON" FontSize="10" Margin="0,0,0,4"/>
                                                        <DatePicker SelectedDate="{Binding DeferUntil, Mode=TwoWay}" Foreground="#101820"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="HANDOVER TO YOUR NEXT WORKDAY" Foreground="{DynamicResource NekoAccentBrush}" FontWeight="Bold" Margin="0,16,0,0"/>
                                <TextBlock Text="Add context, outstanding commitments, or a suggested first priority. Save for later or complete wrap-up to save both your choices and notes. Nothing is sent or changed in source systems." TextWrapping="Wrap" Margin="0,6,0,10"/>
                                <TextBox Text="{Binding WrapUpNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="{Binding WrapUpStatus}" TextWrapping="Wrap" Foreground="{DynamicResource NekoMutedTextBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <UniformGrid Columns="2" Margin="0,20,0,0">
                            <Button Content="PLAN TOMORROW" Command="{Binding PlanTomorrowFromReviewCommand}" Margin="0,0,6,0"/>
                            <Button Content="REVIEW OUTCOMES" Command="{Binding ReviewDayOutcomesCommand}" Margin="3,0"/>
                        </UniformGrid>
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <Button Content="SAVE FOR LATER" Command="{Binding DismissDayReviewCommand}" Margin="0,0,6,0"/>
                            <Button Content="COMPLETE WRAP-UP" Command="{Binding CompleteWrapUpCommand}" Margin="6,0,0,0" Background="{DynamicResource NekoSpiritPurpleBrush}"/>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <Border x:Name="StartupOverlay"
                Grid.ColumnSpan="2"
                Panel.ZIndex="1000"
                Background="#F20A111B">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInitialLoading}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel Width="440"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Width="78" Height="78"
                        CornerRadius="39"
                        HorizontalAlignment="Center"
                        Background="#27204A"
                        BorderBrush="{DynamicResource NekoSpiritPurpleBrush}"
                        BorderThickness="2">
                    <TextBlock Text="◇"
                               Foreground="{DynamicResource NekoSpiritPurpleBrush}"
                               FontSize="40"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="NEKOMATA"
                           Foreground="{DynamicResource NekoSpiritWhiteBrush}"
                           FontSize="34"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,22,0,0"/>
                <TextBlock Text="PERSONAL PLANNING ASSISTANT"
                           Foreground="{DynamicResource NekoAccentBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>

                <ProgressBar IsIndeterminate="True"
                             Height="5"
                             Margin="0,30,0,0"
                             Background="{DynamicResource NekoSurfaceAltBrush}"
                             Foreground="{DynamicResource NekoAccentBrush}"
                             BorderThickness="0"/>

                <TextBlock Text="{Binding LoadingStatus}"
                           Foreground="{DynamicResource NekoMutedTextBrush}"
                           FontSize="13"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>
                <TextBlock Text="Preparing your workspace and today's plan"
                           Foreground="{DynamicResource NekoBorderBrush}"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,7,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
