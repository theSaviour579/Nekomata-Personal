<Window x:Class="Nekomata.UI.Views.GuardianTaskPlannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Meeting Analyzer"
        Height="820"
        Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource NekoBackgroundBrush}">

    <Grid Margin="20"
      Background="{DynamicResource NekoBackgroundBrush}">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="220"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <!-- Header -->

        <StackPanel>

            <TextBlock
                Text="Meeting Analyzer"
                FontSize="28"
                FontWeight="SemiBold"
                Foreground="{DynamicResource NekoTextBrush}"/>

            <TextBlock
                Margin="0,6,0,0"
                Text="Paste meeting notes or describe the decisions made. Guardian will extract actions for your review before anything is applied."
                Opacity="0.75"
                Foreground="{DynamicResource NekoMutedTextBrush}"/>

        </StackPanel>

        <!-- Input -->

        <Border Grid.Row="1"
        Margin="0,20,0,20"
        Background="{DynamicResource NekoSurfaceBrush}"
        BorderBrush="{DynamicResource NekoBorderSoftBrush}"
        BorderThickness="1"
        CornerRadius="14"
        Padding="15">

            <TextBox
        Text="{Binding Instruction, UpdateSourceTrigger=PropertyChanged}"
        AcceptsReturn="True"
        VerticalScrollBarVisibility="Auto"
        TextWrapping="Wrap"
        Background="Transparent"
        BorderThickness="0"
        Foreground="{DynamicResource NekoTextBrush}"
        CaretBrush="{DynamicResource NekoAccentBrush}"
        FontSize="14"/>

        </Border>

        <!-- Buttons -->

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal">

            <Button
                Width="120"
                Height="34"
                Margin="0,0,10,0"
                Content="ANALYZE MEETING"
                Command="{Binding AnalyseCommand}"/>

            <Button
                Width="120"
                Height="34"
                Content="Clear"
                Command="{Binding ClearCommand}"/>

            <TextBlock
                Margin="25,8,0,0"
                VerticalAlignment="Center"
                Text="{Binding StatusMessage}"/>

        </StackPanel>

        <!-- Results -->

        <Grid Grid.Row="3"
      Margin="0,20,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <!-- ================================================= -->
            <!-- PROPOSED ACTIONS                                  -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
            Background="{DynamicResource NekoCardGradientBrush}"
            BorderBrush="{DynamicResource NekoBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="18">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">

                        <TextBlock Text="PROPOSED ACTIONS"
                           Foreground="{DynamicResource NekoAccentBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           DockPanel.Dock="Left"/>

                        <TextBlock Text="{Binding ActionPlan.Actions.Count}"
                           Foreground="{DynamicResource NekoSpiritPurpleBrush}"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"/>

                    </DockPanel>

                    <ListBox Grid.Row="2"
                     ItemsSource="{Binding ActionPlan.Actions}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">

                                <Setter Property="Padding"
                                Value="0"/>

                                <Setter Property="Margin"
                                Value="0"/>

                                <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>

                                <Setter Property="Background"
                                Value="Transparent"/>

                                <Setter Property="BorderThickness"
                                Value="0"/>

                                <Setter Property="FocusVisualStyle"
                                Value="{x:Null}"/>

                                <Style.Triggers>

                                    <Trigger Property="IsSelected"
                                     Value="True">

                                        <Setter Property="Background"
                                        Value="Transparent"/>

                                        <Setter Property="Foreground"
                                        Value="{DynamicResource NekoTextBrush}"/>

                                    </Trigger>

                                    <Trigger Property="IsMouseOver"
                                     Value="True">

                                        <Setter Property="Background"
                                        Value="Transparent"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Border Background="{DynamicResource NekoSurfaceAltBrush}"
                                BorderBrush="{DynamicResource NekoBorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="14"
                                Margin="0,0,0,10">

                                    <StackPanel>

                                        <DockPanel Margin="0,0,0,8">

                                            <StackPanel Orientation="Horizontal"
            DockPanel.Dock="Left">

                                                <CheckBox
        IsChecked="{Binding Selected}"
        VerticalAlignment="Center"
        Margin="0,0,8,0"/>

                                                <Border
        Background="{DynamicResource NekoSpiritPurpleBrush}"
        CornerRadius="7"
        Padding="8,3">

                                                    <TextBlock
            Text="{Binding ActionType}"
            Foreground="{DynamicResource NekoSpiritWhiteBrush}"
            FontSize="9"
            FontWeight="Bold"/>

                                                </Border>

                                            </StackPanel>

                                            <TextBlock Text="{Binding Priority}"
                                               Foreground="{DynamicResource NekoWarningBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>

                                        </DockPanel>

                                        <TextBlock Text="{Binding Title}"
                                           Foreground="{DynamicResource NekoTextBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>

                                        <StackPanel Orientation="Horizontal"
            Margin="0,6,0,0">

                                            <TextBlock
        Text="Confidence"
        Foreground="{DynamicResource NekoMutedTextBrush}"
        FontSize="10"/>

                                            <Border
        Margin="8,0,0,0"
        Background="{DynamicResource NekoSuccessBrush}"
        CornerRadius="6"
        Padding="6,2">

                                                <TextBlock
            Text="{Binding Confidence, StringFormat={}{0}%}"
            Foreground="White"
            FontWeight="Bold"
            FontSize="10"/>

                                            </Border>

                                        </StackPanel>

                                        <TextBlock Text="{Binding Description}"
                                           Foreground="{DynamicResource NekoMutedTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           LineHeight="17"
                                           Margin="0,5,0,0"/>

                                        <TextBlock Text="{Binding Reason}"
                                           Foreground="{DynamicResource NekoMutedTextBrush}"
                                           FontSize="11"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           LineHeight="17"
                                           Margin="0,8,0,0"/>

                                        <ItemsControl
    ItemsSource="{Binding ConfidenceReasons}"
    Margin="0,8,0,0">

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <TextBlock
                Text="{Binding}"
                Foreground="{DynamicResource NekoMutedTextBrush}"
                FontSize="10"
                Margin="0,2,0,0"/>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                        <UniformGrid Columns="3"
                                             Margin="0,12,0,0">

                                            <StackPanel>

                                                <TextBlock Text="TASK ID"
                                                   Foreground="{DynamicResource NekoMutedTextBrush}"
                                                   FontSize="8"/>

                                                <TextBlock Text="{Binding TaskId,
                                                                  TargetNullValue=New}"
                                                   Foreground="{DynamicResource NekoTextBrush}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,3,0,0"/>

                                            </StackPanel>

                                            <StackPanel>

                                                <TextBlock Text="ESTIMATE"
                                                   Foreground="{DynamicResource NekoMutedTextBrush}"
                                                   FontSize="8"/>

                                                <TextBlock Text="{Binding EstimatedMinutes,
                                                                  StringFormat={}{0} min,
                                                                  TargetNullValue=Not set}"
                                                   Foreground="{DynamicResource NekoTextBrush}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,3,0,0"/>

                                            </StackPanel>

                                            <StackPanel>

                                                <TextBlock Text="DUE"
                                                   Foreground="{DynamicResource NekoMutedTextBrush}"
                                                   FontSize="8"/>

                                                <TextBlock Text="{Binding DueAt,
                                                                  StringFormat={}{0:dd MMM yyyy},
                                                                  TargetNullValue=Not set}"
                                                   Foreground="{DynamicResource NekoTextBrush}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,3,0,0"/>

                                            </StackPanel>

                                        </UniformGrid>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>

            <!-- ================================================= -->
            <!-- GUARDIAN QUESTIONS                                -->
            <!-- ================================================= -->

            <Border Grid.Column="2"
            Background="{DynamicResource NekoCardGradientBrush}"
            BorderBrush="{DynamicResource NekoBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="18">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">

                        <TextBlock Text="GUARDIAN QUESTIONS"
                           Foreground="{DynamicResource NekoWarningBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           DockPanel.Dock="Left"/>

                        <TextBlock Text="{Binding ActionPlan.Questions.Count}"
                           Foreground="{DynamicResource NekoWarningBrush}"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"/>

                    </DockPanel>

                    <ListBox Grid.Row="2"
                     ItemsSource="{Binding ActionPlan.Questions}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">

                                <Setter Property="Padding"
                                Value="0"/>

                                <Setter Property="Margin"
                                Value="0"/>

                                <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>

                                <Setter Property="Background"
                                Value="Transparent"/>

                                <Setter Property="BorderThickness"
                                Value="0"/>

                                <Setter Property="FocusVisualStyle"
                                Value="{x:Null}"/>

                                <Style.Triggers>

                                    <Trigger Property="IsSelected"
                                     Value="True">

                                        <Setter Property="Background"
                                        Value="Transparent"/>

                                    </Trigger>

                                    <Trigger Property="IsMouseOver"
                                     Value="True">

                                        <Setter Property="Background"
                                        Value="Transparent"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Border Background="{DynamicResource NekoSurfaceAltBrush}"
                                BorderBrush="{DynamicResource NekoBorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="13"
                                Margin="0,0,0,10">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="?"
                                           Foreground="{DynamicResource NekoWarningBrush}"
                                           FontSize="15"
                                           FontWeight="Bold"/>

                                        <TextBlock Grid.Column="1"
                                           Text="{Binding}"
                                           Foreground="{DynamicResource NekoTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           LineHeight="17"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <!-- Empty state -->

                    <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="20">

                        <StackPanel.Style>
                            <Style TargetType="StackPanel">

                                <Setter Property="Visibility"
                                Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding ActionPlan.Questions.Count}"
                                         Value="0">

                                        <Setter Property="Visibility"
                                        Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="✓"
                           Foreground="{DynamicResource NekoSuccessBrush}"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                        <TextBlock Text="No clarification needed."
                           Foreground="{DynamicResource NekoTextBrush}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>

                        <TextBlock Text="Guardian has enough information to prepare the proposed changes."
                           Foreground="{DynamicResource NekoMutedTextBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,4,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>
        <StackPanel Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,20,0,0">

            <Button
        Width="170"
        Content="Continue to Review"
        Command="{Binding ContinueCommand}"/>

        </StackPanel>

    </Grid>

</Window>