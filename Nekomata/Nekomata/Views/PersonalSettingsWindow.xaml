<Window x:Class="Nekomata.UI.Views.PersonalSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal settings" Width="560" Height="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource NekoBackgroundBrush}"
        Foreground="{DynamicResource NekoTextBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="PERSONAL SETTINGS" Style="{DynamicResource NekoTitleText}"/>
            <TextBlock Text="Change how Nekomata addresses you and manages its optional AI connection."
                       TextWrapping="Wrap" Margin="0,6,0,20" Foreground="{DynamicResource NekoMutedTextBrush}"/>
            <TextBlock Text="YOUR NAME" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="NameInput" FontSize="17" Padding="12,8" MaxLength="80"/>
            <TextBlock Text="OPENAI API KEY" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}" Margin="0,18,0,6"/>
            <PasswordBox x:Name="OpenAiKeyInput" FontSize="16" Padding="12,8"/>
            <TextBlock Text="Leave blank to keep the current key. A new key replaces it securely in Windows Credential Manager."
                       TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource NekoMutedTextBrush}"/>
            <CheckBox x:Name="RemoveOpenAiKey" Content="Remove the saved OpenAI key" Margin="0,12,0,0"
                      Foreground="{DynamicResource NekoTextBrush}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="CANCEL" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="SAVE CHANGES" Click="Save_Click" Background="{DynamicResource NekoSpiritPurpleBrush}"/>
        </StackPanel>
    </Grid>
</Window>
