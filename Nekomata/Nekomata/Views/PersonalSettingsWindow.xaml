<Window x:Class="Nekomata.UI.Views.PersonalSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal settings" Width="680" Height="840" MinHeight="650" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource NekoBackgroundBrush}"
        Foreground="{DynamicResource NekoTextBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
        <StackPanel>
            <TextBlock Text="PERSONAL SETTINGS" Style="{DynamicResource NekoTitleText}"/>
            <TextBlock Text="Change how Nekomata addresses you and manages its optional AI connection."
                       TextWrapping="Wrap" Margin="0,6,0,20" Foreground="{DynamicResource NekoMutedTextBrush}"/>
            <TextBlock Text="YOUR NAME" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="NameInput" FontSize="17" Padding="12,8" MaxLength="80"/>
            <TextBlock Text="JOB TITLE" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}" Margin="0,18,0,6"/>
            <TextBox x:Name="JobTitleInput" FontSize="17" Padding="12,8" MaxLength="120"/>
            <TextBlock Text="Used to tailor Value goals to your own role. Leave blank to use the job title from your connected Microsoft 365 profile."
                       TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource NekoMutedTextBrush}"/>
            <TextBlock Text="WORKING DAY" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}" Margin="0,18,0,6"/>
            <TextBlock Text="These times drive capacity, free-window and working-time calculations. Use HH:mm."
                       TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource NekoMutedTextBrush}"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="START"/><TextBox x:Name="WorkStartInput" Padding="10,7" MaxLength="5"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="FINISH"/><TextBox x:Name="WorkEndInput" Padding="10,7" MaxLength="5"/></StackPanel>
            </Grid>
            <CheckBox x:Name="LunchChoice" Content="Protect a lunch break" Margin="0,14,0,7" Checked="LunchChoice_Changed" Unchecked="LunchChoice_Changed"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="LUNCH START"/><TextBox x:Name="LunchStartInput" Padding="10,7" MaxLength="5"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="LUNCH FINISH"/><TextBox x:Name="LunchEndInput" Padding="10,7" MaxLength="5"/></StackPanel>
            </Grid>
            <TextBlock Text="DAILY WRAP-UP POP-UP" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}" Margin="0,14,0,6"/>
            <TextBox x:Name="WrapUpTimeInput" Padding="10,7" MaxLength="5" Width="150" HorizontalAlignment="Left"/>
            <CheckBox x:Name="EmailBriefingChoice" Content="Email my daily briefing to my signed-in Microsoft mailbox" Margin="0,14,0,0"/>
            <TextBlock Text="One briefing is sent per working day after your configured start time while Nekomata is running."
                       TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource NekoMutedTextBrush}"/>
            <TextBlock Text="OPENAI API KEY" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}" Margin="0,18,0,6"/>
            <PasswordBox x:Name="OpenAiKeyInput" FontSize="16" Padding="12,8"/>
            <TextBlock Text="Leave blank to keep the current key. A new key replaces it securely in Windows Credential Manager."
                       TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource NekoMutedTextBrush}"/>
            <CheckBox x:Name="RemoveOpenAiKey" Content="Remove the saved OpenAI key" Margin="0,12,0,0"
                      Foreground="{DynamicResource NekoTextBrush}"/>
            <TextBlock Text="MICROSOFT AI — ENTRA (OPTIONAL)" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}" Margin="0,18,0,6"/>
            <TextBox x:Name="MicrosoftAiEndpointInput" FontSize="14" Padding="12,8" ToolTip="Example: https://your-resource.openai.azure.com"/>
            <TextBlock Text="Azure OpenAI / Foundry endpoint" Foreground="{DynamicResource NekoMutedTextBrush}" Margin="0,4,0,8"/>
            <TextBox x:Name="MicrosoftAiDeploymentInput" FontSize="14" Padding="12,8" ToolTip="The deployed model name configured in Microsoft Foundry"/>
            <TextBlock Text="Deployment name. When both fields are set, Microsoft AI is preferred and uses the signed-in work account; OpenAI remains the fallback."
                       TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource NekoMutedTextBrush}"/>
            <TextBlock Text="GUARDIAN CONVERSATION PROVIDER" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}" Margin="0,18,0,6"/>
            <ComboBox x:Name="ConversationProviderInput" FontSize="14" Padding="10,7">
                <ComboBoxItem Content="Automatic"/>
                <ComboBoxItem Content="Microsoft 365 Copilot (Preview)"/>
                <ComboBoxItem Content="Microsoft AI (Entra)"/>
                <ComboBoxItem Content="OpenAI"/>
                <ComboBoxItem Content="No AI"/>
            </ComboBox>
            <CheckBox x:Name="CopilotWebSearchInput" Content="Allow web grounding for Microsoft 365 Copilot" Margin="0,10,0,0" Foreground="{DynamicResource NekoTextBrush}"/>
            <TextBlock Text="Copilot requires a licensed work/school account and separate administrator-approved permissions. It is a preview conversational service; structured automation will never fall back to a chargeable provider unless Automatic is selected."
                       TextWrapping="Wrap" Margin="0,5,0,8" Foreground="{DynamicResource NekoMutedTextBrush}"/>
            <Button Content="TEST MICROSOFT 365 COPILOT ACCESS" Click="TestCopilot_Click" HorizontalAlignment="Left"/>
            <TextBlock x:Name="CopilotTestStatus" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource NekoMutedTextBrush}"/>
            <TextBlock Text="SPOTIFY APP CLIENT ID (OPTIONAL)" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}" Margin="0,18,0,6"/>
            <TextBox x:Name="SpotifyClientIdInput" FontSize="14" Padding="12,8"/>
            <TextBlock Text="The public Client ID from the Spotify developer app used by your organisation. Its redirect URI must include http://127.0.0.1:43821/callback/."
                       TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource NekoMutedTextBrush}"/>
            <TextBlock Text="PREFERRED MUSIC SOURCE" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}" Margin="0,18,0,6"/>
            <ComboBox x:Name="MediaProviderInput" FontSize="14" Padding="10,7">
                <ComboBoxItem Content="Spotify"/>
                <ComboBoxItem Content="Apple Music"/>
                <ComboBoxItem Content="YouTube Music"/>
                <ComboBoxItem Content="Radio"/>
            </ComboBox>
            <TextBlock Text="APPLE MUSIC LINK" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}" Margin="0,14,0,6"/>
            <TextBox x:Name="AppleMusicUrlInput" FontSize="14" Padding="12,8" ToolTip="A music.apple.com home, album or playlist link"/>
            <TextBlock Text="YOUTUBE MUSIC LINK" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}" Margin="0,14,0,6"/>
            <TextBox x:Name="YouTubeMusicUrlInput" FontSize="14" Padding="12,8" ToolTip="A music.youtube.com home, album or playlist link"/>
            <TextBlock Text="RADIO STATION LINK" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}" Margin="0,14,0,6"/>
            <TextBox x:Name="RadioStationUrlInput" FontSize="14" Padding="12,8" ToolTip="The station website or web player address"/>
            <TextBlock Text="Apple Music, YouTube Music and radio open the saved page in your default browser. Spotify retains its connected playback controls. Nekomata never downloads or executes content from a saved link."
                       TextWrapping="Wrap" Margin="0,5,0,14" Foreground="{DynamicResource NekoMutedTextBrush}"/>
        </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="CANCEL" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="SAVE CHANGES" Click="Save_Click" Background="{DynamicResource NekoSpiritPurpleBrush}"/>
        </StackPanel>
    </Grid>
</Window>
