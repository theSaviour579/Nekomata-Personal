<Window x:Class="Nekomata.UI.Views.SpotifyArrivalMixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose your Arrival Mix" Width="600" Height="360" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource NekoBackgroundBrush}"
        Foreground="{DynamicResource NekoTextBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="YOUR ARRIVAL MIX" Style="{DynamicResource NekoTitleText}"/>
            <TextBlock Text="Paste the Spotify playlist you want Nekomata to start on shuffle when you arrive."
                       TextWrapping="Wrap" Margin="0,8,0,20" Foreground="{DynamicResource NekoMutedTextBrush}"/>
            <TextBlock Text="SPOTIFY PLAYLIST LINK" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="PlaylistInput" FontSize="15" Padding="12,8"/>
            <TextBlock Text="Example: https://open.spotify.com/playlist/..."
                       Margin="0,6,0,0" Foreground="{DynamicResource NekoMutedTextBrush}"/>
            <TextBlock x:Name="ValidationText" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource NekoCriticalBrush}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="CANCEL" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="SAVE ARRIVAL MIX" Click="Save_Click" Background="{DynamicResource NekoSpiritPurpleBrush}"/>
        </StackPanel>
    </Grid>
</Window>
