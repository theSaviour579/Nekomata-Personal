<Window x:Class="Nekomata.UI.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Nekomata Personal" Width="650" Height="620" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource NekoBackgroundBrush}"
        Foreground="{DynamicResource NekoTextBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="WELCOME TO NEKOMATA" Style="{DynamicResource NekoTitleText}"/>
            <TextBlock Text="Your personal planning assistant" Foreground="{DynamicResource NekoSpiritPurpleBrush}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Let's make this space yours." TextWrapping="Wrap" Margin="0,22,0,8" FontSize="15" Foreground="{DynamicResource NekoTextBrush}"/>

            <TextBlock Text="WHAT SHOULD I CALL YOU?" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}" Margin="0,8,0,6"/>
            <TextBox x:Name="NameInput" FontSize="18" Padding="12,8" MaxLength="80"/>

            <Border Background="{DynamicResource NekoCardGradientBrush}" CornerRadius="14" Padding="18" BorderBrush="{DynamicResource NekoBorderBrush}" BorderThickness="1" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="YOUR PERSONAL WORKSPACE" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}"/>
                    <TextBlock Text="Tasks, projects and planning will be kept privately on this computer. No database setup will be required." TextWrapping="Wrap" Margin="0,5,0,14" Foreground="{DynamicResource NekoMutedTextBrush}"/>
                    <TextBlock Text="MICROSOFT ACCOUNT (OPTIONAL)" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}"/>
                    <TextBlock Text="After setup, you can connect a personal, work or school Microsoft account to use your calendar and email." TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource NekoMutedTextBrush}"/>
                </StackPanel>
            </Border>

            <CheckBox x:Name="StartupChoice" Content="Start Nekomata when I sign in to Windows" Margin="0,18,0,0"
                      Foreground="{DynamicResource NekoTextBrush}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="START USING NEKOMATA" Click="OpenSetup_Click" Background="{DynamicResource NekoSpiritPurpleBrush}"/>
        </StackPanel>
    </Grid>
</Window>
