<Window x:Class="Nekomata.UI.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Nekomata Personal" Width="700" Height="820" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource NekoBackgroundBrush}"
        Foreground="{DynamicResource NekoTextBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
        <StackPanel>
            <TextBlock Text="WELCOME TO NEKOMATA" Style="{DynamicResource NekoTitleText}"/>
            <TextBlock Text="Your personal planning assistant" Foreground="{DynamicResource NekoSpiritPurpleBrush}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Let's make this space yours." TextWrapping="Wrap" Margin="0,22,0,8" FontSize="15" Foreground="{DynamicResource NekoTextBrush}"/>

            <TextBlock Text="WHAT SHOULD I CALL YOU?" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}" Margin="0,8,0,6"/>
            <TextBox x:Name="NameInput" FontSize="18" Padding="12,8" MaxLength="80"/>

            <TextBlock Text="YOUR WORKING DAY" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}" Margin="0,18,0,6"/>
            <TextBlock Text="Enter times as HH:mm. Nekomata uses these hours for capacity, free-time and workload calculations."
                       TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource NekoMutedTextBrush}"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="START"/><TextBox x:Name="WorkStartInput" Padding="10,7" MaxLength="5"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="FINISH"/><TextBox x:Name="WorkEndInput" Padding="10,7" MaxLength="5"/></StackPanel>
            </Grid>
            <CheckBox x:Name="LunchChoice" Content="Protect a lunch break" Margin="0,14,0,7" Checked="LunchChoice_Changed" Unchecked="LunchChoice_Changed"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="LUNCH START"/><TextBox x:Name="LunchStartInput" Padding="10,7" MaxLength="5"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="LUNCH FINISH"/><TextBox x:Name="LunchEndInput" Padding="10,7" MaxLength="5"/></StackPanel>
            </Grid>
            <TextBlock Text="DAILY WRAP-UP POP-UP" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}" Margin="0,14,0,6"/>
            <TextBox x:Name="WrapUpTimeInput" Padding="10,7" MaxLength="5" Width="150" HorizontalAlignment="Left"/>
            <CheckBox x:Name="EmailBriefingChoice" Content="Email my daily briefing to my signed-in Microsoft mailbox" Margin="0,14,0,0"/>
            <TextBlock Text="When enabled, Nekomata sends one briefing on each working day after your configured start time while the app is running."
                       TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource NekoMutedTextBrush}"/>

            <TextBlock Text="OPENAI API KEY (OPTIONAL FALLBACK)" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}" Margin="0,14,0,6"/>
            <PasswordBox x:Name="OpenAiKeyInput" FontSize="16" Padding="12,8"/>
            <TextBlock Text="Leave this blank if you plan to use Microsoft 365 Copilot or an organisation-provided Microsoft AI deployment. Any OpenAI key you enter is stored securely in Windows Credential Manager." TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource NekoMutedTextBrush}"/>

            <Border Background="{DynamicResource NekoCardGradientBrush}" CornerRadius="14" Padding="18" BorderBrush="{DynamicResource NekoBorderBrush}" BorderThickness="1" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="YOUR PERSONAL WORKSPACE" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}"/>
                    <TextBlock Text="Tasks, projects and planning will be kept privately on this computer. No database setup will be required." TextWrapping="Wrap" Margin="0,5,0,14" Foreground="{DynamicResource NekoMutedTextBrush}"/>
                    <TextBlock Text="MICROSOFT ACCOUNT (OPTIONAL)" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}"/>
                    <TextBlock Text="After setup, you can connect a Microsoft account to use calendar, email and Microsoft To Do. Work or school accounts can also import assigned Planner tasks and, with an eligible licence and administrator consent, use Microsoft 365 Copilot. Task import begins read-only." TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource NekoMutedTextBrush}"/>
                </StackPanel>
            </Border>

            <CheckBox x:Name="StartupChoice" Content="Start Nekomata when I sign in to Windows" Margin="0,18,0,0"
                      Foreground="{DynamicResource NekoTextBrush}"/>
            <TextBlock Text="PRIVACY &amp; CONTROL" FontWeight="Bold" Foreground="{DynamicResource NekoAccentBrush}" Margin="0,16,0,6"/>
            <TextBlock Text="Microsoft access is delegated to the account you choose. Nekomata reads your calendar, mail and tasks to build your workspace; calendar and mail changes remain explicit actions. Copilot and web grounding are optional and configured later. You can disconnect Microsoft access from Settings at any time."
                       TextWrapping="Wrap" Foreground="{DynamicResource NekoMutedTextBrush}"/>
        </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="START USING NEKOMATA" Click="OpenSetup_Click" Background="{DynamicResource NekoSpiritPurpleBrush}"/>
        </StackPanel>
    </Grid>
</Window>
