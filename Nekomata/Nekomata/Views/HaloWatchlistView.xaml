<UserControl x:Class="Nekomata.UI.Views.HaloWatchlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedWatchlist" Source="{Binding HaloWatchlistTickets}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="WaitingOwnerLabel"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <StackPanel>
        <Border Padding="24" CornerRadius="20" Background="{DynamicResource NekoCardGradientBrush}"
                BorderBrush="{DynamicResource NekoBorderBrush}" BorderThickness="1" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="HALO WATCHLIST" Foreground="{DynamicResource NekoAccentBrush}" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="Assigned tickets waiting on an end user, hold state or external specialist."
                               Foreground="{DynamicResource NekoTextBrush}" FontSize="14" Margin="0,7,0,0"/>
                    <TextBlock Text="{Binding HaloWatchlistSummary}" Foreground="{DynamicResource NekoWarningBrush}"
                               FontWeight="SemiBold" Margin="0,8,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="REFRESH HALO" Command="{Binding RefreshHaloTicketsCommand}"
                        VerticalAlignment="Center" Padding="16,8" Margin="24,0,0,0"/>
            </Grid>
        </Border>

        <Border Padding="20" CornerRadius="16" Background="#D9131F30" BorderBrush="{DynamicResource NekoBorderSoftBrush}" BorderThickness="1">
            <StackPanel>
                <StackPanel HorizontalAlignment="Center" Margin="25">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HaloWatchlistCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="WATCHLIST CLEAR" Foreground="{DynamicResource NekoSuccessBrush}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Nothing assigned to you is currently waiting on another party."
                               Style="{DynamicResource NekoMutedText}" Margin="0,7,0,0"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedWatchlist}}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,16,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource NekoSpiritPurpleBrush}"
                                                   FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ItemCount, StringFormat={}{0} TICKET(S)}"
                                                   Style="{DynamicResource NekoTinyText}"/>
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="17" CornerRadius="12" Background="{DynamicResource NekoSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource NekoBorderSoftBrush}" BorderThickness="1" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource NekoSpiritWhiteBrush}"
                                                   FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description, StringFormat=Status: {0}}" Style="{DynamicResource NekoMutedText}" Margin="0,5,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                            <TextBlock Text="{Binding LastUpdatedLabel}" Foreground="{DynamicResource NekoTextBrush}" Margin="0,0,16,0"/>
                                            <TextBlock Text="{Binding WaitingAgeLabel}" Foreground="{DynamicResource NekoMutedTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="5" Padding="10,5" Margin="18,0,12,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#25314355"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActionable}" Value="True">
                                                        <Setter Property="Background" Value="#553C2905"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding WatchlistStateLabel}" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource NekoMutedTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActionable}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource NekoWarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <Button Grid.Column="2" Content="OPEN IN HALO"
                                            Command="{Binding DataContext.OpenHaloWatchlistTicketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" VerticalAlignment="Center" Padding="13,7"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>