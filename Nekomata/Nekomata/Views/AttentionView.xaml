<UserControl x:Class="Nekomata.UI.Views.AttentionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Padding="24" CornerRadius="22" Background="{DynamicResource NekoHeaderGradientBrush}"
                BorderBrush="{DynamicResource NekoBorderBrush}" BorderThickness="1" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="GUARDIAN ATTENTION CENTRE" Style="{DynamicResource NekoTitleText}"/>
                    <TextBlock Text="One durable queue for important email, missed plan blocks, deadlines and capacity risks."
                               Style="{DynamicResource NekoMutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding ActiveAttentionCount, StringFormat={}{0} item(s) currently need attention}"
                               Foreground="{DynamicResource NekoWarningBrush}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="CLEAR RESOLVED" Command="{Binding ClearResolvedAttentionCommand}" Margin="0,0,8,0"/>
                    <Button Content="BACK TO DASHBOARD" Command="{Binding ShowDashboardCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Padding="14" CornerRadius="16" Background="{DynamicResource NekoCardGradientBrush}"
                BorderBrush="{DynamicResource NekoBorderSoftBrush}" BorderThickness="1">
            <StackPanel>
                <StackPanel HorizontalAlignment="Center" Margin="20">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasAttentionHistory}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="ALL CLEAR" Foreground="{DynamicResource NekoSuccessBrush}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Guardian has no outstanding or recent attention items." Style="{DynamicResource NekoMutedText}" Margin="0,8,0,0"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding VisibleAttentionItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14" Margin="0,0,0,8" CornerRadius="12" Background="{DynamicResource NekoSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource NekoBorderSoftBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource NekoWarningBrush}" CornerRadius="4" Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Source}" Foreground="{DynamicResource NekoAccentBrush}" FontWeight="Bold" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding Severity}" Foreground="{DynamicResource NekoWarningBrush}" FontWeight="Bold" Margin="0,0,12,0"/>
                                            
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource NekoSpiritWhiteBrush}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource NekoTextBrush}" TextWrapping="Wrap" MaxHeight="180" Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding SnoozeLabel}" Foreground="{DynamicResource NekoWarningBrush}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CreatedLabel}" Style="{DynamicResource NekoMutedText}" HorizontalAlignment="Right" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{Binding ActionLabel}" Command="{Binding DataContext.ActAttentionItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,7,0"/>
                                            <Button Content="SNOOZE 15 MIN" Command="{Binding DataContext.SnoozeAttentionItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,7,0"/>
                                            <Button Content="RESOLVE" Command="{Binding DataContext.ResolveAttentionItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
