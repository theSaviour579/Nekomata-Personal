<UserControl x:Class="Nekomata.UI.Views.BattleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border CornerRadius="22" BorderBrush="{DynamicResource NekoCriticalBrush}" BorderThickness="2" Margin="0,0,0,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#5A310917" Offset="0"/>
                    <GradientStop Color="#26130920" Offset="0.58"/>
                    <GradientStop Color="#121422" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource NekoCriticalBrush}" CornerRadius="4" Padding="9,4" Margin="0,0,12,0">
                            <TextBlock Text="P1 // ACTIVE" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="GUARDIAN INCIDENT COMMAND" Foreground="{DynamicResource NekoCriticalBrush}"
                                   FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="BATTLE MODE" Foreground="{DynamicResource NekoSpiritWhiteBrush}"
                               FontSize="36" FontWeight="Bold" Margin="0,12,0,0"/>
                    <TextBlock Text="Protect service first. Pause routine work, establish impact, communicate, then contain."
                               Foreground="{DynamicResource NekoTextBrush}" FontSize="15" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="30,0,0,0">
                    <TextBlock Text="{Binding BattleIncidentLabel}" Foreground="{DynamicResource NekoCriticalBrush}"
                               FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding BattleSlaCountdown}" Foreground="{DynamicResource NekoSpiritWhiteBrush}"
                               FontSize="25" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding BattleSlaDeadline}" Style="{DynamicResource NekoMutedText}"
                               HorizontalAlignment="Right" Margin="0,5,0,0"/>
                    <Button Content="STAND DOWN MANUALLY" Command="{Binding ExitBattleModeCommand}"
                            HorizontalAlignment="Right" Margin="0,14,0,0" Padding="12,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding BattleTickets}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="22" CornerRadius="16" Background="{DynamicResource NekoCardGradientBrush}"
                            BorderBrush="{DynamicResource NekoCriticalBrush}" BorderThickness="2" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource NekoCriticalBrush}" CornerRadius="3"/>
                            <StackPanel Grid.Column="1" Margin="18,0,28,0">
                                <TextBlock Text="IMMEDIATE RESPONSE REQUIRED" Foreground="{DynamicResource NekoCriticalBrush}"
                                           FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource NekoSpiritWhiteBrush}"
                                           FontSize="23" FontWeight="Bold" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                <TextBlock Text="{Binding Description, StringFormat=Halo status: {0}}"
                                           Foreground="{DynamicResource NekoTextBrush}" FontSize="14" Margin="0,7,0,0"/>
                                <TextBlock Text="{Binding RecommendationReason}" Style="{DynamicResource NekoMutedText}"
                                           TextWrapping="Wrap" Margin="0,12,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,17,0,0">
                                    <Border Background="#2A26354B" CornerRadius="6" Padding="10,7" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding DueAt, StringFormat=SLA DEADLINE  {0:HH:mm}}"
                                                   Foreground="{DynamicResource NekoWarningBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#2A26354B" CornerRadius="6" Padding="10,7" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding EstimatedMinutes, StringFormat=ESTIMATED  {0} MIN}"
                                                   Foreground="{DynamicResource NekoTextBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#2A26354B" CornerRadius="6" Padding="10,7">
                                        <TextBlock Text="{Binding Score, StringFormat=GUARDIAN SCORE  {0}}"
                                                   Foreground="{DynamicResource NekoSpiritPurpleBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="180">
                                <TextBlock Text="P1" Foreground="{DynamicResource NekoCriticalBrush}" FontSize="34"
                                           FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Button Content="OPEN TICKET IN HALO"
                                        Command="{Binding DataContext.OpenHaloBattleTicketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Background="{DynamicResource NekoCriticalBrush}"
                                        Foreground="White" BorderBrush="{DynamicResource NekoCriticalBrush}"
                                        Padding="18,10" Margin="0,12,0,0"/>
                                <Button Content="REFRESH INCIDENT STATUS"
                                        Command="{Binding DataContext.RefreshBattleStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Padding="14,8" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Border Padding="22" CornerRadius="16" Background="#D9131F30" BorderBrush="#4A35435A" BorderThickness="1" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="P1 RESPONSE PROTOCOL" Foreground="{DynamicResource NekoSpiritWhiteBrush}" FontSize="17" FontWeight="Bold"/>
                    <Grid Margin="0,17,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="01  ACKNOWLEDGE" Foreground="{DynamicResource NekoCriticalBrush}" FontWeight="Bold"/>
                            <TextBlock Text="Open Halo, take ownership and start the response clock." Style="{DynamicResource NekoMutedText}" TextWrapping="Wrap" Margin="0,5,0,15"/>
                            <TextBlock Text="02  ESTABLISH IMPACT" Foreground="{DynamicResource NekoWarningBrush}" FontWeight="Bold"/>
                            <TextBlock Text="Confirm who is affected, scope, symptoms and business interruption." Style="{DynamicResource NekoMutedText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="03  CONTAIN + COMMUNICATE" Foreground="{DynamicResource NekoWarningBrush}" FontWeight="Bold"/>
                            <TextBlock Text="Apply the safest containment and post a concise stakeholder update." Style="{DynamicResource NekoMutedText}" TextWrapping="Wrap" Margin="0,5,0,15"/>
                            <TextBlock Text="04  RESOLVE OR ESCALATE" Foreground="{DynamicResource NekoSuccessBrush}" FontWeight="Bold"/>
                            <TextBlock Text="Record evidence, next update time and a named owner before hand-off." Style="{DynamicResource NekoMutedText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="22" CornerRadius="16" Background="#D9131F30" BorderBrush="#4A35435A" BorderThickness="1" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="GUARDIAN DIRECTIVE" Foreground="{DynamicResource NekoCriticalBrush}" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Do not start another planned objective while a P1 remains assigned and open. Guardian will stand down automatically when Halo confirms the incident is cleared or no longer assigned to you."
                               Foreground="{DynamicResource NekoTextBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    <Separator Margin="0,18,0,14" Background="#4A35435A"/>
                    <TextBlock Text="{Binding BattleEffortLabel}" Foreground="{DynamicResource NekoSpiritWhiteBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="Status refreshes automatically and can be forced from the incident card."
                               Style="{DynamicResource NekoMutedText}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>