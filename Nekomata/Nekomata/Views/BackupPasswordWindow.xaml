<Window x:Class="Nekomata.UI.Views.BackupPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Password" Width="460" Height="255" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource NekoBackgroundBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="ENCRYPTION PASSWORD" Style="{DynamicResource NekoSectionTitleText}"/>
        <TextBlock Text="Use at least 12 characters. You will need this exact password when restoring on another laptop. Nekomata never writes it into the backup or Git." TextWrapping="Wrap" Margin="0,8,0,14" Foreground="{DynamicResource NekoMutedTextBrush}"/>
        <PasswordBox x:Name="PasswordInput" Padding="10" FontSize="15"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="CANCEL" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="CONTINUE" IsDefault="True" Click="Continue_Click" Background="{DynamicResource NekoSpiritPurpleBrush}"/>
        </StackPanel>
    </StackPanel>
</Window>
