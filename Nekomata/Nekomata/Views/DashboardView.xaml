<UserControl x:Class="Nekomata.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dashboard="clr-namespace:Nekomata.UI.Controls.Dashboard"
             xmlns:guardian="clr-namespace:Nekomata.UI.Controls.Guardian"
             SizeChanged="DashboardView_SizeChanged">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid x:Name="DashboardLayout">

            <Grid.RowDefinitions>
                <!-- Guardian briefing -->
                <RowDefinition Height="Auto"/>

                <!-- Gap below briefing -->
                <RowDefinition Height="18"/>

                <!-- Left/main dashboard content -->
                <RowDefinition Height="Auto"/>

                <!-- Compact-mode right content -->
                <RowDefinition Height="Auto"/>

                <!-- Mission history -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn"
                                  Width="1.08*"/>

                <ColumnDefinition x:Name="ColumnGap"
                                  Width="20"/>

                <ColumnDefinition x:Name="RightColumn"
                                  Width="0.92*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================================================== -->
            <!-- GUARDIAN DAILY BRIEFING                               -->
            <!-- ===================================================== -->

            <dashboard:GuardianBriefingCard
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"/>

            <!-- ===================================================== -->
            <!-- LEFT: EXECUTION                                       -->
            <!-- ===================================================== -->

            <StackPanel x:Name="LeftDashboardPanel"
                        Grid.Row="2"
                        Grid.Column="0">

                <Border Background="#33FF5A72" BorderBrush="{DynamicResource NekoCriticalBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUrgentHaloTickets}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="⚠ IMMEDIATE ATTENTION" Foreground="{DynamicResource NekoCriticalBrush}"
                                       FontSize="15" FontWeight="Bold" DockPanel.Dock="Left"/>
                            <Button Content="REFRESH" Command="{Binding RefreshIntegrationsCommand}"
                                    HorizontalAlignment="Right" Padding="10,5"/>
                        </DockPanel>
                        <TextBlock Text="{Binding HaloIntegrationStatus}" Style="{DynamicResource NekoMutedText}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding UrgentHaloTickets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource NekoSurfaceBrush}" CornerRadius="9" Padding="11" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource NekoTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding RecommendationReason}" Style="{DynamicResource NekoTinyText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Priority}" Foreground="{DynamicResource NekoCriticalBrush}" FontWeight="Bold" Margin="12,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <dashboard:DashboardCard Title="VIABLE PUSHBACKS"
                    StatusText="{Binding Workspace.Capacity.PushbackSuggestions.Count}" Margin="0,0,0,16">
                    <dashboard:DashboardCard.Style>
                        <Style TargetType="dashboard:DashboardCard">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding HasCapacityPushbacks}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </dashboard:DashboardCard.Style>
                    <StackPanel>
                        <TextBlock Text="Guardian selected lower-priority, lower-scoring commitments that recover capacity without displacing urgent work."
                                   Style="{DynamicResource NekoMutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Workspace.Capacity.PushbackSuggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource NekoSurfaceAltBrush}" BorderBrush="{DynamicResource NekoBorderSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource NekoTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Reason}" Style="{DynamicResource NekoTinyText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                <TextBlock Text="{Binding Score, StringFormat=SCORE {0}}" Foreground="{DynamicResource NekoSpiritPurpleBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding MinutesRecovered, StringFormat=-{0} min}" Foreground="{DynamicResource NekoSuccessBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </dashboard:DashboardCard>
                <dashboard:IntegrationsControl/>

                <!-- ===================================================== -->
                <!-- GUARDIAN SUGGESTED TASKS                              -->
                <!-- ===================================================== -->

                <dashboard:DashboardCard
    Title="GUARDIAN SUGGESTIONS"
    StatusText="{Binding GuardianSuggestedTasks.Count}"
    Margin="0,0,0,16">

                    <Grid>

                        <!-- Suggested task list -->

                        <ItemsControl
            ItemsSource="{Binding GuardianSuggestedTasks}">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border
                        Background="{DynamicResource NekoSurfaceAltBrush}"
                        BorderBrush="{DynamicResource NekoBorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="14"
                        Margin="0,0,0,10">

                                        <StackPanel>

                                            <!-- Category and severity -->

                                            <DockPanel Margin="0,0,0,9">

                                                <Border
                                    Background="{DynamicResource NekoAccentBrush}"
                                    CornerRadius="7"
                                    Padding="7,3"
                                    DockPanel.Dock="Left">

                                                    <TextBlock
                                        Text="{Binding Category}"
                                        Foreground="{DynamicResource NekoBackgroundBrush}"
                                        FontSize="9"
                                        FontWeight="Bold"/>

                                                </Border>

                                                <TextBlock
                                    Text="{Binding Severity}"
                                    Foreground="{DynamicResource NekoWarningBrush}"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>

                                            </DockPanel>

                                            <!-- Insight title -->

                                            <TextBlock
                                Text="{Binding Title}"
                                Foreground="{DynamicResource NekoTextBrush}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"/>

                                            <!-- Explanation -->

                                            <TextBlock
                                Text="{Binding Description}"
                                Foreground="{DynamicResource NekoMutedTextBrush}"
                                FontSize="11"
                                TextWrapping="Wrap"
                                LineHeight="17"
                                Margin="0,5,0,0"/>

                                            <!-- Suggested task details -->

                                            <Border
                                Background="{DynamicResource NekoSurfaceBrush}"
                                BorderBrush="{DynamicResource NekoBorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,12,0,0">

                                                <Grid>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>

                                                        <TextBlock
                                            Text="SUGGESTED TASK"
                                            Foreground="{DynamicResource NekoMutedTextBrush}"
                                            FontSize="8"/>

                                                        <TextBlock
                                            Text="{Binding SuggestedMission.Title}"
                                            Foreground="{DynamicResource NekoTextBrush}"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap"
                                            Margin="0,4,0,0"/>

                                                    </StackPanel>

                                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="15,0,0,0"
                                        HorizontalAlignment="Right">

                                                        <TextBlock
                                            Text="ESTIMATE"
                                            Foreground="{DynamicResource NekoMutedTextBrush}"
                                            FontSize="8"
                                            HorizontalAlignment="Right"/>

                                                        <TextBlock
                                            Text="{Binding SuggestedMission.EstimatedMinutes,
                                                          StringFormat={}{0} min}"
                                            Foreground="{DynamicResource NekoAccentBrush}"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Right"
                                            Margin="0,4,0,0"/>

                                                    </StackPanel>

                                                </Grid>

                                            </Border>

                                            <!-- Buttons added in the next step -->
                                            <StackPanel
    Orientation="Horizontal"
    Margin="0,12,0,0">

                                                <Button
        Content="Add to Backlog"
        Command="{Binding DataContext.AddSuggestedTaskCommand,
                          RelativeSource={RelativeSource AncestorType=UserControl}}"
        CommandParameter="{Binding}"
        MinWidth="130"
        Margin="0,0,10,0"/>

                                                <Button
        Content="Dismiss"
        MinWidth="110"/>

                                            </StackPanel>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                        <!-- Empty state -->

                        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="20">

                            <StackPanel.Style>
                                <Style TargetType="StackPanel">

                                    <Setter Property="Visibility"
                            Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger
                            Binding="{Binding GuardianSuggestedTasks.Count}"
                            Value="0">

                                            <Setter Property="Visibility"
                                    Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </StackPanel.Style>

                            <TextBlock
                Text="✓"
                Foreground="{DynamicResource NekoSuccessBrush}"
                FontSize="26"
                FontWeight="Bold"
                HorizontalAlignment="Center"/>

                            <TextBlock
                Text="No strategic tasks suggested."
                Foreground="{DynamicResource NekoTextBrush}"
                FontSize="14"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"/>

                            <TextBlock
                Text="Guardian has not identified any missing planning actions."
                Foreground="{DynamicResource NekoMutedTextBrush}"
                FontSize="11"
                TextAlignment="Center"
                Margin="0,4,0,0"/>

                        </StackPanel>

                    </Grid>

                </dashboard:DashboardCard>

                <dashboard:DashboardCard
                    Title="DUE TODAY"
                    StatusText="{Binding TodayTasks.Count}">

                    <Grid>

                        <ItemsControl ItemsSource="{Binding TodayTasks}">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <dashboard:TaskCard
                                        Margin="0,0,0,10"

                                        CompleteCommand="{Binding DataContext.CompleteTaskCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="20">

                            <StackPanel.Style>
                                <Style TargetType="StackPanel">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TodayTasks.Count}"
                                                     Value="0">

                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                        </DataTrigger>
                                    </Style.Triggers>

                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="✓"
                                       Foreground="{DynamicResource NekoSuccessBrush}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Nothing is due today."
                                       Foreground="{DynamicResource NekoTextBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Guardian will continue prioritising strategic work."
                                       Foreground="{DynamicResource NekoMutedTextBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                    </Grid>

                </dashboard:DashboardCard>

                <Border Grid.Row="2"
        Background="{DynamicResource NekoSurfaceBrush}"
        BorderBrush="{DynamicResource NekoBorderSoftBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Padding="20"
        Margin="0,20,0,0">

                    <StackPanel>

                        <TextBlock Text="INTEGRATION HEALTH"
                   Foreground="{DynamicResource NekoWarningBrush}"
                   FontWeight="SemiBold"
                   FontSize="12"
                   Margin="0,0,0,15"/>

                        <ItemsControl ItemsSource="{Binding Workspace.Integrations}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Grid Margin="0,6">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status -->

                                        <Ellipse Width="10"
                                 Height="10"
                                 VerticalAlignment="Center">

                                            <Ellipse.Style>

                                                <Style TargetType="Ellipse">

                                                    <Setter Property="Fill"
                                            Value="Orange"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding Connected}"
                                                     Value="True">

                                                            <Setter Property="Fill"
                                                    Value="LimeGreen"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Ellipse.Style>

                                        </Ellipse>

                                        <!-- Name -->

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource NekoTextBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding LastRefresh, StringFormat=Last synced {0:HH:mm:ss}}" Foreground="{DynamicResource NekoMutedTextBrush}" FontSize="10"/>
                                        </StackPanel>

                                        <!-- Status -->

                                        <TextBlock Grid.Column="2"
                                   Text="{Binding Status, StringFormat={}{0}}"
                                   Foreground="{DynamicResource NekoMutedTextBrush}"/>

                                        <!-- Mission count -->

                                        <TextBlock Grid.Column="3"
                                   Text="{Binding MissionCount}"
                                   Foreground="{DynamicResource NekoAccentBrush}"
                                   FontWeight="Bold"/>

                                    </Grid>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

            </StackPanel>

            <!-- ===================================================== -->
            <!-- RIGHT: GUARDIAN AND PERFORMANCE                       -->
            <!-- ===================================================== -->

            <StackPanel x:Name="RightDashboardPanel"
                        Grid.Row="2"
                        Grid.Column="2">

                <guardian:GuardianRecommendationCard
                    DataContext="{Binding TopRecommendation}"

                    AskGuardianCommand="{Binding DataContext.AskGuardianAboutRecommendationCommand,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"

                    StartMissionCommand="{Binding DataContext.StartRecommendedMissionCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"

                    Margin="0,0,0,16"/>

                <dashboard:ProductivityCard
                    Margin="0,0,0,16"/>

                <!-- Compact project summary -->

                <Border Background="{DynamicResource NekoCardGradientBrush}"
                        BorderBrush="{DynamicResource NekoBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="20"
                        Margin="0,0,0,16">

                    <StackPanel>

                        <TextBlock Text="PROJECT PORTFOLIO"
                                   Foreground="{DynamicResource NekoTextBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Active project overview"
                                   Foreground="{DynamicResource NekoMutedTextBrush}"
                                   FontSize="12"
                                   Margin="0,4,0,16"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{DynamicResource NekoSurfaceAltBrush}"
                                    CornerRadius="12"
                                    Padding="14">

                                <StackPanel>
                                    <TextBlock Text="ACTIVE"
                                               Foreground="{DynamicResource NekoMutedTextBrush}"
                                               FontSize="10"/>

                                    <TextBlock Text="{Binding ActiveProjectCount}"
                                               Foreground="{DynamicResource NekoAccentBrush}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Margin="0,5,0,0"/>
                                </StackPanel>

                            </Border>

                            <Border Grid.Column="2"
                                    Background="{DynamicResource NekoSurfaceAltBrush}"
                                    CornerRadius="12"
                                    Padding="14">

                                <StackPanel>
                                    <TextBlock Text="AT RISK"
                                               Foreground="{DynamicResource NekoMutedTextBrush}"
                                               FontSize="10"/>

                                    <TextBlock Text="{Binding AtRiskProjectCount}"
                                               Foreground="{DynamicResource NekoWarningBrush}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Margin="0,5,0,0"/>
                                </StackPanel>

                            </Border>

                            <Border Grid.Column="4"
                                    Background="{DynamicResource NekoSurfaceAltBrush}"
                                    CornerRadius="12"
                                    Padding="14">

                                <StackPanel>
                                    <TextBlock Text="TOTAL ACTIVE VALUE"
                                               Foreground="{DynamicResource NekoMutedTextBrush}"
                                               FontSize="10"/>

                                    <TextBlock Text="{Binding ActiveProjectValue,
                                                              StringFormat=£{0:N0}}"
                                               Foreground="{DynamicResource NekoMoneyBrush}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Margin="0,5,0,0"/>
                                </StackPanel>

                            </Border>

                        </Grid>

                        <Button Content="+ NEW PROJECT"
                                Command="{Binding NewProjectCommand}"
                                HorizontalAlignment="Right"
                                Padding="16,8"
                                Margin="0,16,0,0"/>

                    </StackPanel>

                </Border>

            </StackPanel>

            <!-- ===================================================== -->
            <!-- FULL-WIDTH HISTORY                                    -->
            <!-- ===================================================== -->

            <dashboard:MissionHistoryCard
                Grid.Row="4"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="0,18,0,0"/>

        </Grid>

    </ScrollViewer>

</UserControl>