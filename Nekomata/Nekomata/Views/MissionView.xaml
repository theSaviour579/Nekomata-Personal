<UserControl x:Class="Nekomata.UI.Views.MissionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:home="clr-namespace:Nekomata.UI.Controls.Home">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="True">

        <Grid Background="{DynamicResource NekoBackgroundBrush}"
              Margin="0,0,10,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- FOCUS: the Guardian core counts the session down in cyan; everything else is quiet. -->
            <StackPanel Grid.Row="0" Margin="0,0,0,26">
                <DockPanel Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentDateTime, StringFormat={}{0:HH:mm}}" FontFamily="Cascadia Mono, Consolas" FontSize="24" Foreground="#8C96B0"/>
                    <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#5D6784" VerticalAlignment="Center"><Run Text="● " Foreground="#42D9FF"/><Run Text="GUARDIAN IS GUARDING YOUR FOCUS"/></TextBlock>
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,30,0" MaxWidth="300" Opacity="0.85">
                        <TextBlock Text="HELD FOR LATER" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#8C96B0" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding HomeHeldCount}" FontFamily="Cascadia Mono, Consolas" FontSize="40" Foreground="#B7C0D6" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                        <TextBlock Text="Spoken updates Guardian is holding until this session ends." FontSize="13" Foreground="#8C96B0" TextWrapping="Wrap" TextAlignment="Right"/>
                        <TextBlock Text="AFTER THIS" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#8C96B0" HorizontalAlignment="Right" Margin="0,24,0,0"/>
                        <TextBlock Text="{Binding HomeNowNext}" FontSize="13" Foreground="#B7C0D6" TextWrapping="Wrap" TextAlignment="Right" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Grid Grid.Column="1" Width="560" Height="560">
                        <Viewbox>
                            <home:GuardianCore Items="{Binding HomeCoreItems}" DayStart="{Binding HomeCoreDayStart}" DayEnd="{Binding HomeCoreDayEnd}" Now="{Binding HomeNow}"
                                               ShowNow="True" DimDay="True" Progress="{Binding MissionCoreProgress}" Accent="#42D9FF" State="{Binding GuardianPresenceState}"
                                               Calm="{Binding HomeCalm}"/>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="260">
                            <TextBlock Text="{Binding MissionStateText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#42D9FF" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Text="{Binding Workspace.CurrentMission.Title}" FontSize="24" FontWeight="SemiBold" Foreground="#E6E9F5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" MaxHeight="64" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding MissionRemaining}" FontFamily="Cascadia Mono, Consolas" FontSize="56" Foreground="#DFF7FF" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#8C96B0" HorizontalAlignment="Center"><Run Text="ELAPSED "/><Run Text="{Binding MissionElapsed, Mode=OneWay}"/></TextBlock>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="30,0,0,0" MaxWidth="300" Opacity="0.85">
                        <TextBlock Text="BREAKS THROUGH ONLY FOR" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#8C96B0"/>
                        <TextBlock FontSize="14" Foreground="#B7C0D6" Margin="0,8,0,0" LineHeight="24">Anything critical<LineBreak/>Your next meeting, 5 minutes before<LineBreak/>Anything you ask for</TextBlock>
                        <TextBlock Text="WHY THIS" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#8C96B0" Margin="0,24,0,0"/>
                        <TextBlock Text="{Binding Workspace.CurrentMission.RecommendationReason}" FontSize="13" Foreground="#8C96B0" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="80" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
                <WrapPanel HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button Content="Done" Command="{Binding CompleteMissionCommand}" Height="48" Padding="28,0" Margin="6,0" FontSize="15"
                            Background="#7B5DFF" Foreground="White" BorderThickness="0"/>
                    <Button Content="{Binding MissionPauseButtonText}" Command="{Binding ToggleMissionPauseCommand}" Height="48" Padding="22,0" Margin="6,0" FontSize="15"
                            ToolTip="Pause or resume without losing elapsed time"/>
                    <Button Content="Need more time" Command="{Binding MissionNeedsMoreTimeCommand}" Height="48" Padding="22,0" Margin="6,0" FontSize="15"/>
                    <Button Content="I'm blocked" Command="{Binding MissionBlockedCommand}" Height="48" Padding="22,0" Margin="6,0" FontSize="15"/>
                    <Button Content="Hold for later" Command="{Binding HoldMissionForLaterCommand}" Height="48" Padding="22,0" Margin="6,0" FontSize="15"
                            ToolTip="Save elapsed focus and return the remaining work to the plan"/>
                    <Button Content="Discard" Command="{Binding ExitMissionCommand}" Height="48" Padding="22,0" Margin="6,0" FontSize="15"
                            ToolTip="Exit without recording this session's elapsed time"/>
                </WrapPanel>
            </StackPanel>

            <!-- Below the core: only what's needed while focusing. The check-in and the interruption triage appear
                 when they're wanted; music and the interrupt key sit quietly on one line. -->
            <StackPanel Grid.Row="1" MaxWidth="900" Margin="0,0,0,24">
                    <!-- Guardian accountability check-in -->
                    <Border CornerRadius="20" Padding="18" Margin="0,0,0,18"
                            Background="#332B1D" BorderBrush="{DynamicResource NekoWarningBrush}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MissionCheckInVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding MissionCheckInTitle}" Foreground="{DynamicResource NekoWarningBrush}" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="{Binding MissionCheckInDetail}" Foreground="{DynamicResource NekoTextBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            <TextBox Text="{Binding MissionBlockerNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Optional: describe a blocker or why more time is needed"
                                     Margin="0,12,0,0" MinHeight="38" VerticalContentAlignment="Center"/>
                            <UniformGrid Columns="4" Margin="0,12,0,0">
                                <Button Content="ON TRACK" Command="{Binding MissionOnTrackCommand}" Margin="0,0,6,0"/>
                                <Button Content="BLOCKED" Command="{Binding MissionBlockedCommand}" Margin="2,0,4,0"/>
                                <Button Content="FINISHED" Command="{Binding MissionFinishedFromCheckInCommand}" Margin="4,0,2,0"
                                        Background="{DynamicResource NekoSuccessBrush}" Foreground="{DynamicResource NekoBackgroundBrush}"/>
                                <Button Content="+30 MIN" Command="{Binding MissionNeedsMoreTimeCommand}" Margin="6,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding MissionCheckInStatus}" Style="{DynamicResource NekoTinyText}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" Margin="4,0,4,10"/>
                    <Border CornerRadius="20" Padding="18" Margin="0,0,0,14"
                            Background="#352431" BorderBrush="{DynamicResource NekoWarningBrush}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding InterruptionPanelVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding InterruptionHeadline}" Foreground="{DynamicResource NekoWarningBrush}" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="{Binding InterruptionAdvice}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBox Text="{Binding InterruptionInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,12,0,0" MinHeight="42" VerticalContentAlignment="Center"
                                     ToolTip="Example: Rhys - Entra issue - needs looking at today">
                                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding TriageInterruptionCommand}"/></TextBox.InputBindings>
                            </TextBox>
                            <TextBox Text="{Binding InterruptionResumeNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,8,0,0" MinHeight="42" TextWrapping="Wrap"
                                     ToolTip="Resume point: what were you doing and what is the next concrete step?"/>
                            <Button Content="TRIAGE" Command="{Binding TriageInterruptionCommand}" Margin="0,8,0,0"/>
                            <UniformGrid Columns="4" Margin="0,10,0,0">
                                <Button Content="SWITCH" Command="{Binding ApplyInterruptionDecisionCommand}" CommandParameter="Urgent" Margin="0,0,5,0"/>
                                <Button Content="QUEUE" Command="{Binding ApplyInterruptionDecisionCommand}" CommandParameter="Queued" Margin="2,0,3,0"/>
                                <Button Content="DELEGATE" Command="{Binding ApplyInterruptionDecisionCommand}" CommandParameter="Delegated" Margin="3,0,2,0"/>
                                <Button Content="CANCEL" Command="{Binding CancelInterruptionCommand}" Margin="5,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Command="{Binding OpenInterruptionCommand}" Cursor="Hand" Margin="16,0,0,0"
                            ToolTip="Pause and triage a human interruption without automatically changing priority">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" CornerRadius="8" BorderThickness="1" BorderBrush="#80FFC857" Background="Transparent" Padding="14,7">
                                    <TextBlock Text="⚡ INTERRUPT  F8" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#FFC857"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#26FFC857"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Resources>
                            <Style x:Key="Icon" TargetType="Button">
                                <Setter Property="Foreground" Value="#C8CEE0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Width" Value="32"/>
                                <Setter Property="Height" Value="32"/>
                                <Setter Property="Margin" Value="6,0,0,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B" CornerRadius="8" BorderThickness="1" BorderBrush="#4D9C85FF" Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#267B5DFF"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#8C96B0" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" Margin="0,0,6,0">
                            <Run Text="♪ " Foreground="#46F0B4"/><Run Text="{Binding SpotifyTrack, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding SpotifyArtist, Mode=OneWay}" Foreground="#5D6784"/>
                        </TextBlock>
                        <Button Command="{Binding SpotifyPreviousCommand}" Style="{StaticResource Icon}" ToolTip="Previous"><TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></Button>
                        <Button Command="{Binding ToggleSpotifyPlaybackCommand}" Style="{StaticResource Icon}" ToolTip="Play / pause">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE768;"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding SpotifyIsPlaying}" Value="True"><Setter Property="Text" Value="&#xE769;"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Command="{Binding SpotifyNextCommand}" Style="{StaticResource Icon}" ToolTip="Next"><TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></Button>
                        <Button Command="{Binding SpotifyVolumeDownCommand}" Style="{StaticResource Icon}" ToolTip="Volume down"><TextBlock Text="&#xE993;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></Button>
                        <Button Command="{Binding SpotifyVolumeUpCommand}" Style="{StaticResource Icon}" ToolTip="Volume up"><TextBlock Text="&#xE995;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></Button>
                        <Button Command="{Binding ConnectSpotifyCommand}" Style="{StaticResource Icon}" ToolTip="{Binding SpotifyConnectLabel}"><TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></Button>
                    </StackPanel>
                </DockPanel>
            </StackPanel>

        </Grid>

    </ScrollViewer>

</UserControl>
