<UserControl x:Class="Nekomata.UI.Views.MissionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="True">

        <Grid Background="{DynamicResource NekoBackgroundBrush}"
              Margin="0,0,10,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================================================== -->
            <!-- MISSION HEADER -->
            <!-- ================================================== -->

            <Border Grid.Row="0"
                    CornerRadius="28"
                    Padding="28"
                    Background="{DynamicResource NekoHeaderGradientBrush}"
                    BorderBrush="{DynamicResource NekoSpiritPurpleBrush}"
                    BorderThickness="1"
                    Margin="0,0,0,22">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="{Binding MissionStateText}"
                                   Foreground="{DynamicResource NekoAccentBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>

                        <TextBlock Text="{Binding Workspace.CurrentMission.Title}"
                                   Foreground="{DynamicResource NekoSpiritWhiteBrush}"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Margin="0,10,20,0"/>

                        <TextBlock Text="{Binding Workspace.CurrentMission.RecommendationReason}"
                                   Style="{DynamicResource NekoMutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,20,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <TextBlock Text="{Binding Workspace.CurrentMission.Score}"
                                   Foreground="{DynamicResource NekoSuccessBrush}"
                                   FontSize="46"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Text="MISSION SCORE"
                                   Style="{DynamicResource NekoTinyText}"
                                   HorizontalAlignment="Right"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- ================================================== -->
            <!-- MAIN MISSION CONTENT -->
            <!-- ================================================== -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="0.9*"/>
                </Grid.ColumnDefinitions>

                <!-- ================================================== -->
                <!-- LEFT COLUMN -->
                <!-- ================================================== -->

                <StackPanel Grid.Column="0">

                    <!-- Current objective -->
                    <Border CornerRadius="24"
                            Padding="22"
                            Background="{DynamicResource NekoCardGradientBrush}"
                            BorderBrush="{DynamicResource NekoBorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,18">

                        <StackPanel>

                            <TextBlock Text="CURRENT OBJECTIVE"
                                       Foreground="{DynamicResource NekoAccentBrush}"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="{Binding Workspace.CurrentMission.Decision.Summary}"
                                       Foreground="{DynamicResource NekoSpiritWhiteBrush}"
                                       FontSize="23"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"/>

                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding MissionSessionProgress}"
                                         Height="10"
                                         Margin="0,24,0,0"/>

                            <TextBlock Text="{Binding MissionSessionProgress,
                                                      StringFormat=Session progress: {0:F0}%}"
                                       Style="{DynamicResource NekoTinyText}"
                                       Margin="0,8,0,0"/>
                            <UniformGrid Columns="3" Margin="0,16,0,0">
                                <Border Background="{DynamicResource NekoSurfaceAltBrush}" CornerRadius="12" Padding="12" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="ELAPSED" Style="{DynamicResource NekoTinyText}"/>
                                        <TextBlock Text="{Binding MissionElapsed}" Foreground="{DynamicResource NekoSpiritWhiteBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource NekoSurfaceAltBrush}" CornerRadius="12" Padding="12" Margin="3,0">
                                    <StackPanel>
                                        <TextBlock Text="SESSION REMAINING" Style="{DynamicResource NekoTinyText}"/>
                                        <TextBlock Text="{Binding MissionRemaining}" Foreground="{DynamicResource NekoAccentBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource NekoSurfaceAltBrush}" CornerRadius="12" Padding="12" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="SESSION TARGET" Style="{DynamicResource NekoTinyText}"/>
                                        <TextBlock Text="{Binding MissionSessionEstimate}" Foreground="{DynamicResource NekoSpiritWhiteBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                        </StackPanel>

                    </Border>

                    <!-- Mission resources -->
                    <Border CornerRadius="24"
                            Padding="22"
                            Background="{DynamicResource NekoCardGradientBrush}"
                            BorderBrush="{DynamicResource NekoBorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,18">

                        <StackPanel>

                            <TextBlock Text="MISSION RESOURCES"
                                       Foreground="{DynamicResource NekoAccentBrush}"
                                       FontWeight="SemiBold"/>

                            <UniformGrid Columns="2"
                                         Margin="0,18,0,0">

                                <Border Background="{DynamicResource NekoSurfaceAltBrush}"
                                        CornerRadius="16"
                                        Padding="16"
                                        Margin="0,0,8,8">

                                    <StackPanel>
                                        <TextBlock Text="EMAILS"
                                                   Style="{DynamicResource NekoTinyText}"/>

                                        <TextBlock Text="Pending"
                                                   Foreground="{DynamicResource NekoWarningBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="18"/>
                                    </StackPanel>

                                </Border>

                                <Border Background="{DynamicResource NekoSurfaceAltBrush}"
                                        CornerRadius="16"
                                        Padding="16"
                                        Margin="8,0,0,8">

                                    <StackPanel>
                                        <TextBlock Text="HALO"
                                                   Style="{DynamicResource NekoTinyText}"/>

                                        <TextBlock Text="Pending"
                                                   Foreground="{DynamicResource NekoWarningBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="18"/>
                                    </StackPanel>

                                </Border>

                                <Border Background="{DynamicResource NekoSurfaceAltBrush}"
                                        CornerRadius="16"
                                        Padding="16"
                                        Margin="0,8,8,0">

                                    <StackPanel>
                                        <TextBlock Text="SQL"
                                                   Style="{DynamicResource NekoTinyText}"/>

                                        <TextBlock Text="Ready"
                                                   Foreground="{DynamicResource NekoSuccessBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="18"/>
                                    </StackPanel>

                                </Border>

                                <Border Background="{DynamicResource NekoSurfaceAltBrush}"
                                        CornerRadius="16"
                                        Padding="16"
                                        Margin="8,8,0,0">

                                    <StackPanel>
                                        <TextBlock Text="FILES"
                                                   Style="{DynamicResource NekoTinyText}"/>

                                        <TextBlock Text="Pending"
                                                   Foreground="{DynamicResource NekoWarningBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="18"/>
                                    </StackPanel>

                                </Border>

                            </UniformGrid>

                        </StackPanel>

                    </Border>

                    <!-- Mission context -->
                    <Border CornerRadius="24"
                            Padding="22"
                            Background="{DynamicResource NekoCardGradientBrush}"
                            BorderBrush="{DynamicResource NekoBorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,18">

                        <StackPanel>

                            <TextBlock Text="MISSION CONTEXT"
                                       Foreground="{DynamicResource NekoAccentBrush}"
                                       FontWeight="SemiBold"/>

                            <Grid Margin="0,18,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock Text="SOURCE TYPE"
                                               Style="{DynamicResource NekoTinyText}"/>

                                    <TextBlock Text="{Binding Workspace.CurrentMission.SourceType}"
                                               Style="{DynamicResource NekoBodyText}"
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,14"/>

                                    <TextBlock Text="TASK ID"
                                               Style="{DynamicResource NekoTinyText}"/>

                                    <TextBlock Text="{Binding Workspace.CurrentMission.TaskId,
                                                              TargetNullValue=No linked task}"
                                               Style="{DynamicResource NekoBodyText}"
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,14"/>

                                    <TextBlock Text="PROJECT ID"
                                               Style="{DynamicResource NekoTinyText}"/>

                                    <TextBlock Text="{Binding Workspace.CurrentMission.ProjectId,
                                                              TargetNullValue=No linked project}"
                                               Style="{DynamicResource NekoBodyText}"
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock Text="BUSINESS VALUE"
                                               Style="{DynamicResource NekoTinyText}"/>

                                    <TextBlock Text="{Binding Workspace.CurrentMission.BusinessValue,
                                                              StringFormat=£{0:N0}}"
                                               Foreground="{DynamicResource NekoSuccessBrush}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Margin="0,4,0,14"/>

                                    <TextBlock Text="ESTIMATED DURATION"
                                               Style="{DynamicResource NekoTinyText}"/>

                                    <TextBlock Text="{Binding Workspace.CurrentMission.EstimatedDuration}"
                                               Style="{DynamicResource NekoBodyText}"
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,14"/>

                                    <TextBlock Text="BEGIN BEFORE"
                                               Style="{DynamicResource NekoTinyText}"/>

                                    <TextBlock Text="{Binding Workspace.CurrentMission.StartBefore,
                                                              StringFormat={}{0:dd MMM yyyy HH:mm}}"
                                               Foreground="{DynamicResource NekoWarningBrush}"
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                            </Grid>

                            <Border Background="{DynamicResource NekoSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource NekoBorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14"
                                    Margin="0,20,0,0">

                                <StackPanel>

                                    <TextBlock Text="WHY THIS WAS SELECTED"
                                               Foreground="{DynamicResource NekoAccentBrush}"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="{Binding Workspace.CurrentMission.RecommendationReason}"
                                               Style="{DynamicResource NekoBodyText}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"/>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </Border>

                    <!-- Guardian accountability check-in -->
                    <Border CornerRadius="20" Padding="18" Margin="0,0,0,18"
                            Background="#332B1D" BorderBrush="{DynamicResource NekoWarningBrush}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MissionCheckInVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding MissionCheckInTitle}" Foreground="{DynamicResource NekoWarningBrush}" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="{Binding MissionCheckInDetail}" Foreground="{DynamicResource NekoTextBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            <TextBox Text="{Binding MissionBlockerNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Optional: describe a blocker or why more time is needed"
                                     Margin="0,12,0,0" MinHeight="38" VerticalContentAlignment="Center"/>
                            <UniformGrid Columns="4" Margin="0,12,0,0">
                                <Button Content="ON TRACK" Command="{Binding MissionOnTrackCommand}" Margin="0,0,6,0"/>
                                <Button Content="BLOCKED" Command="{Binding MissionBlockedCommand}" Margin="2,0,4,0"/>
                                <Button Content="FINISHED" Command="{Binding MissionFinishedFromCheckInCommand}" Margin="4,0,2,0"
                                        Background="{DynamicResource NekoSuccessBrush}" Foreground="{DynamicResource NekoBackgroundBrush}"/>
                                <Button Content="+30 MIN" Command="{Binding MissionNeedsMoreTimeCommand}" Margin="6,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding MissionCheckInStatus}" Style="{DynamicResource NekoTinyText}"
                               TextWrapping="Wrap" Margin="4,0,4,10"/>

                    <!-- Mission controls -->
                    <Border CornerRadius="20"
                            Padding="16"
                            Background="{DynamicResource NekoCardGradientBrush}"
                            BorderBrush="{DynamicResource NekoBorderBrush}"
                            BorderThickness="1">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="{Binding MissionPauseButtonText}"
                                    Command="{Binding ToggleMissionPauseCommand}"
                                    ToolTip="Pause or resume this session without losing elapsed time"
                                    Height="42"/>

                            <Button Grid.Column="2"
                                    Content="HOLD FOR LATER"
                                    Command="{Binding HoldMissionForLaterCommand}"
                                    ToolTip="Save elapsed focus and return the remaining work to the plan"
                                    Height="42"/>

                            <Button Grid.Column="4"
                                    Content="COMPLETE"
                                    Command="{Binding CompleteMissionCommand}"
                                    Height="42"
                                    Background="{DynamicResource NekoSuccessBrush}"
                                    Foreground="{DynamicResource NekoBackgroundBrush}"/>

                            <Button Grid.Column="6"
                                    Content="DISCARD SESSION"
                                    Command="{Binding ExitMissionCommand}"
                                    ToolTip="Exit without recording this session's elapsed time"
                                    Height="42"/>

                        </Grid>

                    </Border>

                </StackPanel>

                <!-- ================================================== -->
                <!-- RIGHT COLUMN -->
                <!-- ================================================== -->

                <StackPanel Grid.Column="2">

                    <!-- Guardian analysis -->
                    <Border CornerRadius="24"
                            Padding="22"
                            Background="{DynamicResource NekoCardGradientBrush}"
                            BorderBrush="{DynamicResource NekoSpiritPurpleBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,18">

                        <StackPanel>

                            <TextBlock Text="GUARDIAN"
                                       Foreground="{DynamicResource NekoSpiritPurpleBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="{Binding Workspace.Guardian.Summary}"
                                       Style="{DynamicResource NekoBodyText}"
                                       TextWrapping="Wrap"
                                       LineHeight="22"
                                       Margin="0,14,0,0"/>

                            <TextBlock Text="MISSION ANALYSIS"
                                       Foreground="{DynamicResource NekoAccentBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,22,0,0"/>

                            <!-- Strengths -->
                            <TextBlock Text="STRENGTHS"
                                       Style="{DynamicResource NekoTinyText}"
                                       Margin="0,12,0,6"/>

                            <ItemsControl ItemsSource="{Binding Workspace.CurrentMission.Strengths}">

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,0,6">

                                            <TextBlock Text="✓ "
                                                       Foreground="{DynamicResource NekoSuccessBrush}"
                                                       FontWeight="Bold"/>

                                            <TextBlock Text="{Binding}"
                                                       Style="{DynamicResource NekoBodyText}"
                                                       TextWrapping="Wrap"/>

                                        </StackPanel>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                            <!-- Risks -->
                            <TextBlock Text="RISKS"
                                       Style="{DynamicResource NekoTinyText}"
                                       Margin="0,18,0,6"/>

                            <ItemsControl ItemsSource="{Binding Workspace.CurrentMission.Risks}">

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,0,6">

                                            <TextBlock Text="⚠ "
                                                       Foreground="{DynamicResource NekoWarningBrush}"
                                                       FontWeight="Bold"/>

                                            <TextBlock Text="{Binding}"
                                                       Style="{DynamicResource NekoBodyText}"
                                                       TextWrapping="Wrap"/>

                                        </StackPanel>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                            <!-- Guardian decision and score explanation -->
                            <Border Margin="0,20,0,0"
                                    Padding="18"
                                    CornerRadius="14"
                                    Background="{DynamicResource NekoSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource NekoSpiritPurpleBrush}"
                                    BorderThickness="1">

                                <StackPanel>

                                    <TextBlock Text="GUARDIAN DECISION"
                                               Foreground="{DynamicResource NekoAccentBrush}"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="{Binding Workspace.CurrentMission.Decision.Summary}"
                                               Style="{DynamicResource NekoBodyText}"
                                               Margin="0,10,0,0"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="WHY THIS MISSION?"
                                               Foreground="{DynamicResource NekoAccentBrush}"
                                               FontWeight="SemiBold"
                                               Margin="0,22,0,8"/>

                                    <ItemsControl ItemsSource="{Binding Workspace.CurrentMission.ScoreFactors}">

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>

                                                <Grid Margin="0,0,0,10">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>

                                                        <TextBlock Text="{Binding Name}"
                                                                   Style="{DynamicResource NekoBodyText}"
                                                                   FontWeight="SemiBold"/>

                                                        <TextBlock Text="{Binding Explanation}"
                                                                   Style="{DynamicResource NekoTinyText}"
                                                                   TextWrapping="Wrap"/>

                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Points,
                                                                             StringFormat={}{0:+0;-0;0}}"
                                                               Foreground="{DynamicResource NekoSuccessBrush}"
                                                               FontWeight="Bold"
                                                               Margin="14,0,0,0"/>

                                                </Grid>

                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </Border>

                    <!-- Mission metrics -->
                    <Border CornerRadius="24"
                            Padding="22"
                            Background="{DynamicResource NekoCardGradientBrush}"
                            BorderBrush="{DynamicResource NekoBorderBrush}"
                            BorderThickness="1">

                        <StackPanel>

                            <TextBlock Text="MISSION METRICS"
                                       Foreground="{DynamicResource NekoAccentBrush}"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="{Binding Workspace.CurrentMission.EstimatedDuration,
                                                      StringFormat=Task effort remaining: {0}}"
                                       Style="{DynamicResource NekoBodyText}"
                                       Margin="0,18,0,0"/>

                            <TextBlock Text="{Binding MissionSessionEstimate,
                                                      StringFormat=This session target: {0}}"
                                       Foreground="{DynamicResource NekoAccentBrush}"
                                       FontSize="14"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="{Binding Workspace.CurrentMission.StartBefore,
                                                      StringFormat=Begin before: {0:HH:mm}}"
                                       Foreground="{DynamicResource NekoWarningBrush}"
                                       FontSize="14"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="{Binding Workspace.CurrentMission.ThreatLevel,
                                                      StringFormat=Threat level: {0}}"
                                       Foreground="{DynamicResource NekoCriticalBrush}"
                                       FontSize="14"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="MISSION SESSION"
                                       Foreground="{DynamicResource NekoAccentBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,22,0,0"/>

                            <TextBlock Text="{Binding MissionElapsed,
                                                      StringFormat=Elapsed: {0}}"
                                       Style="{DynamicResource NekoBodyText}"
                                       Margin="0,10,0,0"/>

                            <TextBlock Text="{Binding MissionRemaining,
                                                      StringFormat=Remaining: {0}}"
                                       Foreground="{DynamicResource NekoSuccessBrush}"
                                       FontSize="14"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="{Binding Workspace.Guardian.Confidence,
                                                      StringFormat=Guardian confidence: {0}%}"
                                       Foreground="{DynamicResource NekoSuccessBrush}"
                                       FontSize="14"
                                       Margin="0,18,0,0"/>

                            <TextBlock Text="{Binding Workspace.Guardian.RiskLevel,
                                                      StringFormat=Risk: {0}}"
                                       Foreground="{DynamicResource NekoWarningBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="{Binding Workspace.CurrentMission.Status,
                                                      StringFormat=Mission status: {0}}"
                                       Style="{DynamicResource NekoBodyText}"
                                       FontWeight="SemiBold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>

        </Grid>

    </ScrollViewer>

</UserControl>