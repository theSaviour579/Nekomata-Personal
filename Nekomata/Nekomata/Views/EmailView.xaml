<UserControl x:Class="Nekomata.UI.Views.EmailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Padding="24" CornerRadius="22" Background="{DynamicResource NekoHeaderGradientBrush}"
                BorderBrush="{DynamicResource NekoBorderBrush}" BorderThickness="1" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="GUARDIAN INBOX" Style="{DynamicResource NekoTitleText}"/>
                    <TextBlock Text="Local-first triage for unread Outlook mail. AI drafting is opt-in per message; Guardian never sends automatically."
                               Style="{DynamicResource NekoMutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="REFRESH INBOX" Command="{Binding RefreshEmailCommand}" Margin="0,0,8,0"/>
                    <Button Content="BACK TO DASHBOARD" Command="{Binding ShowDashboardCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="16" CornerRadius="14" Background="{DynamicResource NekoSurfaceAltBrush}" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="UNREAD" Style="{DynamicResource NekoTinyText}"/><TextBlock Text="{Binding UnreadEmailCount}" Foreground="{DynamicResource NekoAccentBrush}" FontSize="26" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="16" CornerRadius="14" Background="{DynamicResource NekoSurfaceAltBrush}" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="PRIORITY" Style="{DynamicResource NekoTinyText}"/><TextBlock Text="{Binding PriorityEmailCount}" Foreground="{DynamicResource NekoWarningBrush}" FontSize="26" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="16" CornerRadius="14" Background="{DynamicResource NekoSurfaceAltBrush}" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="FILTERED" Style="{DynamicResource NekoTinyText}"/><TextBlock Text="{Binding FilteredEmailCount}" Foreground="{DynamicResource NekoMutedTextBrush}" FontSize="26" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Padding="16" CornerRadius="14" Background="{DynamicResource NekoSurfaceAltBrush}">
                <StackPanel><TextBlock Text="STATUS" Style="{DynamicResource NekoTinyText}"/><TextBlock Text="{Binding ManagementEmailCount, StringFormat=MANAGEMENT ATTENTION: {0}}" Foreground="{DynamicResource NekoCriticalBrush}" FontWeight="Bold" Margin="0,4,0,2"/><TextBlock Text="{Binding EmailStatus}" TextWrapping="Wrap" Foreground="{DynamicResource NekoTextBrush}" Margin="0,4,0,0"/><TextBlock Text="{Binding EmailLastRefreshedLabel}" Style="{DynamicResource NekoMutedText}" Margin="0,3,0,0"/></StackPanel>
            </Border>
        </Grid>

        <Border Padding="22" CornerRadius="18" Background="{DynamicResource NekoCardGradientBrush}"
                BorderBrush="{DynamicResource NekoBorderSoftBrush}" BorderThickness="1">
            <StackPanel>
                <StackPanel HorizontalAlignment="Center" Margin="20">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowEmailEmptyState}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="INBOX CLEAR" Foreground="{DynamicResource NekoSuccessBrush}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="No unread messages need Guardian's attention." Style="{DynamicResource NekoMutedText}" Margin="0,8,0,0"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding EmailItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="18" Margin="0,0,0,12" CornerRadius="16" Background="{DynamicResource NekoSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource NekoBorderSoftBrush}" BorderThickness="1">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Classification}" Foreground="{DynamicResource NekoAccentBrush}" FontWeight="Bold" Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding PriorityLabel}" Foreground="{DynamicResource NekoWarningBrush}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message.Subject}" Foreground="{DynamicResource NekoSpiritWhiteBrush}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding SenderLine}" Style="{DynamicResource NekoMutedText}" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding CcLine}" Visibility="{Binding CcLine, Converter={StaticResource StringToVisibilityConverter}}" Foreground="{DynamicResource NekoMutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding ReceivedLabel}" Style="{DynamicResource NekoMutedText}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding AttachmentLabel}" Style="{DynamicResource NekoTinyText}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding DisplayContent}" Foreground="{DynamicResource NekoTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="MaxHeight" Value="70"/><Style.Triggers><DataTrigger Binding="{Binding IsBodyExpanded}" Value="True"><Setter Property="MaxHeight" Value="1200"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="{Binding BodyToggleLabel}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="9,4"
                                            Command="{Binding DataContext.ToggleEmailBodyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <Border Background="{DynamicResource NekoSurfaceSoftBrush}" BorderBrush="{DynamicResource NekoBorderSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="MEETING AVAILABILITY" Foreground="{DynamicResource NekoSpiritPurpleBrush}" FontWeight="Bold"/>
                                            <TextBlock Text="Choose the requested day and duration. Guardian ranks genuine free working-time slots from Outlook." Style="{DynamicResource NekoMutedText}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <DatePicker SelectedDate="{Binding SelectedMeetingDate, Mode=TwoWay}" Width="150" VerticalAlignment="Center"/>
                                                <Button Content="ADD DATE" Command="{Binding DataContext.AddMeetingDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="9,5" Margin="6,0,0,0"/>
                                                <TextBox Text="{Binding RequestedMeetingMinutes, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="8,0,4,0" Padding="8,5" VerticalContentAlignment="Center"/>
                                                <TextBlock Text="minutes" Foreground="{DynamicResource NekoMutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button Content="FIND BEST TIMES" Command="{Binding DataContext.FindMeetingTimesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="10,5"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding MeetingDateOptions}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Label}" Foreground="{DynamicResource NekoTextBrush}" Margin="0,0,14,5"/></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding MeetingTimePreference, StringFormat=Detected preference: {0}}" Foreground="{DynamicResource NekoMutedTextBrush}" Margin="0,2,0,0"/>                                            <TextBlock Text="{Binding MeetingSuggestions}" Visibility="{Binding MeetingSuggestions, Converter={StaticResource StringToVisibilityConverter}}" Foreground="{DynamicResource NekoSuccessBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource NekoSurfaceSoftBrush}" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource NekoMutedTextBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SuggestedAction, StringFormat=GUARDIAN: {0}}" Foreground="{DynamicResource NekoAccentBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="OPEN IN OUTLOOK" Command="{Binding DataContext.OpenEmailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,0"/>
                                        <Button Content="DRAFT IN MY VOICE" ToolTip="Clicking shares this email and up to five recent Sent Items with the configured AI provider for style matching" Command="{Binding DataContext.GenerateEmailDraftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,0"/>
                                        <Button Content="DRAFT AS GUARDIAN" ToolTip="Clicking shares this email with the configured AI provider and identifies Guardian as your personal assistant" Command="{Binding DataContext.GenerateGuardianEmailDraftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,0"/>
                                        <Button Content="APPLY CATEGORY" Command="{Binding DataContext.ApplyEmailCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,0"/>
                                        <Button Content="{Binding ManagementActionLabel}" Command="{Binding DataContext.ToggleManagementSenderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding DraftText, Converter={StaticResource StringToVisibilityConverter}}" Margin="0,12,0,0">
                                        <TextBlock Text="EDIT REPLY - REVIEW BEFORE SENDING" Foreground="{DynamicResource NekoSpiritPurpleBrush}" FontWeight="Bold"/>
                                        <TextBox Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" Margin="0,7,0,8"
                                                 ToolTip="Edit the reply freely here before saving or sending">
                                            <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="IsReadOnly" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding ReplySent}" Value="True"><Setter Property="IsReadOnly" Value="True"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
                                        </TextBox>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="SAVE / UPDATE OUTLOOK DRAFT" Command="{Binding DataContext.SaveEmailDraftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,0">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding ReplySent}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                            </Button>
                                            <Button Content="SEND REPLY NOW" ToolTip="Sends the current edited reply immediately" Command="{Binding DataContext.SendEmailDraftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="{DynamicResource NekoSpiritPurpleBrush}" Foreground="{DynamicResource NekoSpiritWhiteBrush}">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource NekoSpiritPurpleBrush}"/><Setter Property="Foreground" Value="{DynamicResource NekoSpiritWhiteBrush}"/><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding ReplySent}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DraftStatus}" Visibility="{Binding DraftStatus, Converter={StaticResource StringToVisibilityConverter}}" Foreground="{DynamicResource NekoSuccessBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
