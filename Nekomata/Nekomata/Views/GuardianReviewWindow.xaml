<Window x:Class="Nekomata.UI.Views.GuardianReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guardian Review"
        Height="800"
        Width="950"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource NekoBackgroundBrush}">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <StackPanel>

            <TextBlock
                Text="Guardian Review"
                FontSize="28"
                FontWeight="SemiBold"
                Foreground="{DynamicResource NekoTextBrush}"/>

            <TextBlock
                Margin="0,6,0,0"
                Text="Review the proposed changes before Guardian applies anything."
                Foreground="{DynamicResource NekoMutedTextBrush}"/>

        </StackPanel>

        <!-- Summary -->

        <Border Grid.Row="1"
                Margin="0,20,0,20"
                Background="{DynamicResource NekoCardGradientBrush}"
                BorderBrush="{DynamicResource NekoBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16">

            <TextBlock
                Text="{Binding ActionPlan.Summary}"
                TextWrapping="Wrap"
                Foreground="{DynamicResource NekoTextBrush}"
                FontSize="14"/>

        </Border>

        <!-- Actions -->

        <Border Grid.Row="2"
                Background="{DynamicResource NekoCardGradientBrush}"
                BorderBrush="{DynamicResource NekoBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16">

            <ListBox ItemsSource="{Binding ActionPlan.Actions}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource NekoSurfaceAltBrush}"
                                BorderBrush="{DynamicResource NekoBorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Selected}"
                                          VerticalAlignment="Top"
                                          Margin="0,3,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{DynamicResource NekoTextBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{DynamicResource NekoMutedTextBrush}"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Reason}"
                                               Foreground="{DynamicResource NekoMutedTextBrush}"
                                               FontStyle="Italic"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="15,0,0,0">
                                    <TextBlock Text="{Binding ActionType}"
                                               Foreground="{DynamicResource NekoAccentBrush}"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Priority, StringFormat=Priority: {0}}"
                                               Foreground="{DynamicResource NekoWarningBrush}"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding EstimatedMinutes, StringFormat=Estimate: {0} min, TargetNullValue=Estimate: not set}"
                                               Foreground="{DynamicResource NekoMutedTextBrush}"
                                               Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding DueAt, StringFormat=Due: {0:dd MMM yyyy}, TargetNullValue=Due: not set}"
                                               Foreground="{DynamicResource NekoMutedTextBrush}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Border>

        <!-- Buttons -->

        <Grid Grid.Row="3" Margin="0,20,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource NekoMutedTextBrush}"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

            <Button
                Width="150"
                Margin="0,0,10,0"
                Content="Apply selected"
                Command="{Binding ApplyCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>

            <Button
                Width="120"
                Content="Cancel"
                Command="{Binding CancelCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>

            </StackPanel>
        </Grid>

    </Grid>

</Window>
