<Window x:Class="Nekomata.UI.Views.GuardianReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guardian Review"
        Height="800"
        Width="950"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource NekoBackgroundBrush}">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <StackPanel>

            <TextBlock
                Text="Guardian Review"
                FontSize="28"
                FontWeight="SemiBold"
                Foreground="{DynamicResource NekoTextBrush}"/>

            <TextBlock
                Margin="0,6,0,0"
                Text="Review the proposed changes before Guardian applies anything."
                Foreground="{DynamicResource NekoMutedTextBrush}"/>

        </StackPanel>

        <!-- Summary -->

        <Border Grid.Row="1"
                Margin="0,20,0,20"
                Background="{DynamicResource NekoCardGradientBrush}"
                BorderBrush="{DynamicResource NekoBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16">

            <TextBlock
                Text="{Binding ActionPlan.Summary}"
                TextWrapping="Wrap"
                Foreground="{DynamicResource NekoTextBrush}"
                FontSize="14"/>

        </Border>

        <!-- Actions -->

        <Border Grid.Row="2"
                Background="{DynamicResource NekoCardGradientBrush}"
                BorderBrush="{DynamicResource NekoBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16">

            <TextBlock
                Text="Actions will appear here."
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource NekoMutedTextBrush}"/>

        </Border>

        <!-- Buttons -->

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button
                Width="150"
                Margin="0,0,10,0"
                Content="Apply"/>

            <Button
                Width="120"
                Content="Cancel"/>

        </StackPanel>

    </Grid>

</Window>