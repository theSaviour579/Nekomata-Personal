<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Keep unstyled text readable on the dark Personal shell. Explicit
         control colours still win, and ComboBox retains its native palette. -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
    </Style>

    <!-- Guardian HUD buttons: a hairline purple outline on the dark ground, rounded, lighting up on hover. -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        <Setter Property="BorderBrush" Value="#809C85FF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Base" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border x:Name="Hover" CornerRadius="10" Background="#2A7B5DFF" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Background" Value="#4D7B5DFF"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Base" Property="BorderBrush" Value="#42D9FF"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource NekoSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource NekoSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource NekoTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Dropdowns: a full template, because the Windows one ignores Background and draws a white box and list. -->
    <ControlTemplate x:Key="NekoComboToggle" TargetType="ToggleButton">
        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Data="M 0 0 L 4 4 L 8 0"
                  Stroke="#9C85FF" StrokeThickness="1.6" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#9C85FF" /></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#42D9FF" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource NekoSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderSoftBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Template="{StaticResource NekoComboToggle}" Focusable="False" ClickMode="Press"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter x:Name="Content" IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" TextElement.Foreground="{TemplateBinding Foreground}" />
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}" Background="Transparent" BorderThickness="0"
                                 Foreground="{TemplateBinding Foreground}" CaretBrush="{TemplateBinding Foreground}" Padding="0" Margin="10,0,28,0" VerticalAlignment="Center" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="#F2100E1F" BorderBrush="#809C85FF" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Content" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource NekoSurfaceSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource NekoSpiritWhiteBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource NekoSpiritPurpleBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource NekoSpiritWhiteBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{DynamicResource NekoSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderSoftBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
    </Style>

    <!-- The text part of a date picker is its own control with its own white background. -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource NekoTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Margin="6,2" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource NekoSurfaceSoftBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource NekoSurfaceSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource NekoSpiritWhiteBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource NekoSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource NekoBorderSoftBrush}" />
        <Setter Property="RowBackground" Value="{DynamicResource NekoSurfaceBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource NekoSurfaceAltBrush}" />
        <Setter Property="HeadersVisibility" Value="Column" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource NekoSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource NekoSurfaceAltBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource NekoSurfaceSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource NekoSpiritWhiteBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderSoftBrush}" />
        <Setter Property="Padding" Value="7,5" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource NekoSurfaceSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NekoAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderSoftBrush}" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Background" Value="{DynamicResource NekoSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NekoMutedTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderSoftBrush}" />
        <Setter Property="Padding" Value="12,7" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource NekoSurfaceAltBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource NekoAccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderSoftBrush}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource NekoSurfaceSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NekoSpiritWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Menus (the day ring's click menu, right-click menus): dark HUD panels rather than the white Windows default. -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Foreground" Value="#E6E9F5" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="#F2100E1F" BorderBrush="#809C85FF" BorderThickness="1" CornerRadius="10" Padding="6" MinWidth="220">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="#E6E9F5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="12,8">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#337B5DFF" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#9C85FF" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                            <Setter Property="FontSize" Value="11" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
