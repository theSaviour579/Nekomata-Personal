<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="NekoTitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource NekoAccentBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="42" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="NekoSectionTitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource NekoAccentBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="NekoHeadingText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="NekoBodyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="NekoMutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource NekoMutedTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="NekoTinyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource NekoMutedTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="11" />
    </Style>

</ResourceDictionary>