<UserControl x:Class="Nekomata.UI.Controls.GuardianContextBriefingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root">
    <Border Padding="18" CornerRadius="16" Background="{DynamicResource NekoCardGradientBrush}"
            BorderBrush="{DynamicResource NekoSpiritPurpleBrush}" BorderThickness="1" Margin="0,0,0,14">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="GUARDIAN CONTEXT" Foreground="{DynamicResource NekoAccentBrush}" FontWeight="Bold" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding Briefing.StateLabel, ElementName=Root}" Foreground="{DynamicResource NekoWarningBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Briefing.ConfidencePercent, ElementName=Root, StringFormat= · {0}% confidence}"
                               Foreground="{DynamicResource NekoMutedTextBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding Briefing.Headline, ElementName=Root}" Foreground="{DynamicResource NekoSpiritWhiteBrush}"
                           FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0"/>
                <TextBlock Text="{Binding Briefing.Summary, ElementName=Root}" Foreground="{DynamicResource NekoTextBrush}"
                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                <TextBlock Text="{Binding Briefing.Evidence, ElementName=Root}" Foreground="{DynamicResource NekoMutedTextBrush}"
                           TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding Briefing.NextAction, ElementName=Root}" Command="{Binding ActionCommand, ElementName=Root}"
                    VerticalAlignment="Center" Margin="22,0,0,0" Padding="14,8" MaxWidth="260">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding Briefing.HasAction, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
