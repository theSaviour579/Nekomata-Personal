<UserControl x:Class="Nekomata.UI.Controls.Guardian.GuardianProposalPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{DynamicResource NekoCardGradientBrush}"
            BorderBrush="{DynamicResource NekoLightningBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="GUARDIAN REVIEW" Style="{DynamicResource NekoSectionTitleText}"/>
                    <TextBlock Text="Review, edit and approve Guardian’s proposed workspace changes."
                               Style="{DynamicResource NekoHeadingText}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding ProjectName, ElementName=Root}"
                               Foreground="{DynamicResource NekoMutedTextBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="SELECT ALL" Click="SelectAllClick" Margin="0,0,8,0" Padding="10,5"/>
                    <Button Content="CLEAR" Click="ClearAllClick" Padding="10,5"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#111D2A" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Proposal.Message, ElementName=Root}" TextWrapping="Wrap"
                               Foreground="{DynamicResource NekoTextBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <TextBlock Text="SELECTED" Style="{DynamicResource NekoTinyText}"/>
                        <TextBlock x:Name="SelectedCountText" Text="0 of 0" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource NekoAccentBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="20,0,0,0">
                        <TextBlock Text="NEW WORK" Style="{DynamicResource NekoTinyText}"/>
                        <TextBlock x:Name="EffortText" Text="0 mins" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="20,0,0,0">
                        <TextBlock Text="VALUE" Style="{DynamicResource NekoTinyText}"/>
                        <TextBlock x:Name="ValueText" Text="£0" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource NekoMoneyBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource NekoSurfaceSoftBrush}" CornerRadius="10"
                    Padding="12,8" Margin="0,0,0,12">
                <TextBlock x:Name="ImpactText" Text="Nothing selected."
                           Foreground="{DynamicResource NekoMutedTextBrush}" TextWrapping="Wrap"/>
            </Border>

            <ScrollViewer Grid.Row="3" MaxHeight="520" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel x:Name="ChangesSection" Margin="0,0,0,14">
                        <TextBlock Text="WORKSPACE CHANGES" Style="{DynamicResource NekoSectionTitleText}"
                                   Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ChangesItems" ItemsSource="{Binding Proposal.Changes, ElementName=Root}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource NekoSurfaceAltBrush}"
                                            BorderBrush="{DynamicResource NekoBorderSoftBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"
                                                      Checked="ProposalSelectionChanged"
                                                      Unchecked="ProposalSelectionChanged"
                                                      VerticalAlignment="Top" Margin="0,3,12,0"/>
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#26384B" CornerRadius="7" Padding="8,3" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding EntityType}" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Property}" FontSize="16" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border Background="#111D2A" CornerRadius="8" Padding="10" Margin="0,9,12,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding CalendarTimeLabel}"
                                                                   Foreground="{DynamicResource NekoAccentBrush}"
                                                                   FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding CalendarTitle}" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding OldValue, StringFormat=Current: {0}}"
                                                                   Foreground="{DynamicResource NekoMutedTextBrush}"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="Proposed value" Style="{DynamicResource NekoTinyText}"
                                                                   Margin="0,6,0,3"/>
                                                        <TextBox Text="{Binding NewValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                 TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,8,12,0"
                                                           Foreground="{DynamicResource NekoMutedTextBrush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{DynamicResource NekoSpiritPurpleBrush}"
                                                    CornerRadius="8" Padding="8,4" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Confidence, StringFormat={}{0}%}"
                                                           Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="TasksSection">
                        <TextBlock Text="NEW TASKS" Style="{DynamicResource NekoSectionTitleText}"
                                   Margin="0,0,0,8"/>
                        <ItemsControl x:Name="TasksItems" ItemsSource="{Binding Proposal.Tasks, ElementName=Root}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource NekoSurfaceAltBrush}"
                                            BorderBrush="{DynamicResource NekoBorderSoftBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="170"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"
                                                      Checked="ProposalSelectionChanged"
                                                      Unchecked="ProposalSelectionChanged"
                                                      VerticalAlignment="Top" Margin="0,3,12,0"/>
                                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"/>
                                                <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="54" Margin="0,7,0,8"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="{DynamicResource NekoSpiritPurpleBrush}"
                                                            CornerRadius="7" Padding="8,3" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Priority}" Foreground="White" FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding SuggestedDelegate, TargetNullValue=Unassigned, StringFormat=Owner: {0}}"
                                                               Foreground="{DynamicResource NekoMutedTextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="ESTIMATED MINUTES" Style="{DynamicResource NekoTinyText}"/>
                                                <TextBox Text="{Binding EstimatedMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Margin="0,3,0,8" LostFocus="ProposalValueChanged"/>
                                                <TextBlock Text="BUSINESS VALUE" Style="{DynamicResource NekoTinyText}"/>
                                                <TextBox Text="{Binding EstimatedBusinessValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Margin="0,3,0,8" LostFocus="ProposalValueChanged"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox Content="SQL" IsChecked="{Binding RequiresSql}" IsHitTestVisible="False" Margin="0,0,10,0"/>
                                                    <CheckBox Content="Focus" IsChecked="{Binding RequiresFocus}" IsHitTestVisible="False"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Nothing is changed until you apply the selected items."
                               Foreground="{DynamicResource NekoMutedTextBrush}"/>
                    <TextBlock Text="Calendar batches can be undone from Calendar after applying."
                               Style="{DynamicResource NekoTinyText}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="DISMISS" Command="{Binding DismissCommand, ElementName=Root}"
                            Width="100" Margin="0,0,9,0"/>
                    <Button Content="REGENERATE" Command="{Binding RegenerateCommand, ElementName=Root}"
                            Width="120" Margin="0,0,9,0"/>
                    <Button Content="APPLY SELECTED" Command="{Binding CreateTasksCommand, ElementName=Root}"
                            Width="170" Background="{DynamicResource NekoSpiritPurpleBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
