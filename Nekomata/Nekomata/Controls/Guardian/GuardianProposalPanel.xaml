<UserControl x:Class="Nekomata.UI.Controls.Guardian.GuardianProposalPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <Border Background="{DynamicResource NekoCardGradientBrush}"
            BorderBrush="{DynamicResource NekoLightningBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="18">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,14">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="GUARDIAN PROPOSAL"
                               Style="{DynamicResource NekoSectionTitleText}"/>

                    <TextBlock Text="{Binding ProjectName, ElementName=Root}"
                               Style="{DynamicResource NekoHeadingText}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{DynamicResource NekoSurfaceSoftBrush}"
                        CornerRadius="10"
                        Padding="10,5"
                        VerticalAlignment="Center">

                    <TextBlock>

<Run Text="{Binding Proposal.Changes.Count,
                    ElementName=Root,
                    Mode=OneWay}"/>

    <Run Text=" changes"/>

    <Run Text=" • "/>

   <Run Text="{Binding Proposal.Tasks.Count,
                    ElementName=Root,
                    Mode=OneWay}"/>

    <Run Text=" tasks"/>

                    </TextBlock>
                </Border>
            </Grid>

            <!-- Summary -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Proposal.Message, ElementName=Root}"
                       Style="{DynamicResource NekoBodyText}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14"/>

            <!-- Proposed Changes -->

            <StackPanel Grid.Row="2"
            Margin="0,0,0,12">

                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility"
                    Value="Collapsed"/>

                        <Style.Triggers>

                            <DataTrigger
    Binding="{Binding Proposal.HasChanges,
                      ElementName=Root,
                      Mode=OneWay}"
    Value="True">

                                <Setter Property="Visibility"
            Value="Visible"/>

                            </DataTrigger>

                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="RECOMMENDED CHANGES"
               Style="{DynamicResource NekoSectionTitleText}"
               Margin="0,0,0,10"/>

                <ItemsControl ItemsSource="{Binding Proposal.Changes,
                                       ElementName=Root}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Background="{DynamicResource NekoSurfaceAltBrush}"
                        BorderBrush="{DynamicResource NekoBorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14"
                        Margin="0,0,0,10">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <CheckBox
                                Content="Apply this change"
                                IsChecked="{Binding Selected}"
                                Margin="0,0,0,10"/>

                                        <Border Background="#111D2A"
                                                BorderBrush="{DynamicResource NekoAccentBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="11"
                                                Margin="0,0,0,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCalendarChange}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="155"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding CalendarTimeLabel}"
                                                           Foreground="{DynamicResource NekoAccentBrush}"
                                                           FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CalendarTitle}"
                                                           Foreground="{DynamicResource NekoTextBrush}"
                                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock
                                Text="{Binding EntityType}"
                                Style="{DynamicResource NekoTinyText}"/>

                                        <TextBlock
                                Text="{Binding Property}"
                                Style="{DynamicResource NekoHeadingText}"/>

                                        <TextBlock>
                                <Run Text="Current: "/>
                                <Run Text="{Binding OldValue}"
                                     FontWeight="SemiBold"/>
                                        </TextBlock>

                                        <TextBlock>
                                <Run Text="New: "/>
                                <Run Text="{Binding NewValue}"
                                     FontWeight="SemiBold"/>
                                        </TextBlock>

                                        <TextBlock Text="{Binding Reason}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Style="{DynamicResource NekoBodyText}"/>

                                    </StackPanel>

                                    <Border Grid.Column="1"
                                Background="{DynamicResource NekoSpiritPurpleBrush}"
                                CornerRadius="8"
                                Padding="8,4">

                                        <TextBlock Text="{Binding Confidence,
                                                     StringFormat={}{0}%}"
                                       Foreground="White"
                                       FontWeight="Bold"/>

                                    </Border>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

            <!-- Proposed Tasks -->
            <ScrollViewer Grid.Row="3"
                          MaxHeight="360"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <ItemsControl ItemsSource="{Binding Proposal.Tasks,
                                                   ElementName=Root}">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border Background="{DynamicResource NekoSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource NekoBorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14"
                                    Margin="0,0,0,10">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <CheckBox Content="Create this task"
                                                  IsChecked="{Binding Selected,
                                                                      Mode=TwoWay}"
                                                  Foreground="{DynamicResource NekoTextBrush}"
                                                  Margin="0,0,0,10"/>

                                        <TextBlock Text="{Binding Title}"
                                                   Style="{DynamicResource NekoHeadingText}"
                                                   FontSize="17"/>

                                        <TextBlock Text="{Binding Description}"
                                                   Style="{DynamicResource NekoBodyText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,20,10"/>

                                        <StackPanel Orientation="Horizontal">

                                            <Border Background="{DynamicResource NekoSpiritPurpleBrush}"
                                                    CornerRadius="8"
                                                    Padding="8,3"
                                                    Margin="0,0,8,0">

                                                <TextBlock Text="{Binding Priority}"
                                                           Foreground="White"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"/>
                                            </Border>

                                            <TextBlock Text="{Binding EstimatedMinutes,
                                                                      StringFormat={}{0} mins}"
                                                       Style="{DynamicResource NekoTinyText}"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Text="  •  "
                                                       Style="{DynamicResource NekoTinyText}"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Text="{Binding SuggestedDelegate,
                                                                      TargetNullValue=Unassigned}"
                                                       Style="{DynamicResource NekoTinyText}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,10,0,0">

                                            <CheckBox Content="SQL"
                                                      IsChecked="{Binding RequiresSql}"
                                                      IsHitTestVisible="False"
                                                      Foreground="{DynamicResource NekoMutedTextBrush}"
                                                      Margin="0,0,14,0"/>

                                            <CheckBox Content="Focus"
                                                      IsChecked="{Binding RequiresFocus}"
                                                      IsHitTestVisible="False"
                                                      Foreground="{DynamicResource NekoMutedTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                HorizontalAlignment="Right">

                                        <TextBlock Text="VALUE"
                                                   Style="{DynamicResource NekoTinyText}"
                                                   HorizontalAlignment="Right"/>

                                        <TextBlock Text="{Binding EstimatedBusinessValue,
                                                                  StringFormat=£{0:N0}}"
                                                   Foreground="{DynamicResource NekoMoneyBrush}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>

                                </Grid>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Actions -->
            <Grid Grid.Row="4"
                  Margin="0,10,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Nothing has been saved yet."
                           Style="{DynamicResource NekoTinyText}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <Button Content="DISMISS"
                            Command="{Binding DismissCommand, ElementName=Root}"
                            Width="100"
                            Height="38"
                            Margin="0,0,10,0"/>

                    <Button Content="REGENERATE"
                            Command="{Binding RegenerateCommand, ElementName=Root}"
                            Width="120"
                            Height="38"
                            Margin="0,0,10,0"/>

                    <Button Content="APPLY SELECTED"
                        Command="{Binding CreateTasksCommand,
                                          ElementName=Root}"
                        Width="170"
                        Height="38"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>