<UserControl x:Class="Nekomata.UI.Controls.Dashboard.ProjectCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <Border Margin="0,0,0,16"
            Padding="20"
            CornerRadius="18"
            Background="{DynamicResource NekoCardGradientBrush}"
            BorderBrush="{DynamicResource NekoBorderBrush}"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->
                <StackPanel Grid.Column="0">

                    <TextBlock Text="{Binding Name}"
                               Style="{DynamicResource NekoHeadingText}"/>

                    <TextBlock Text="{Binding Description}"
                               Style="{DynamicResource NekoBodyText}"
                               Margin="0,8,0,18"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal">

                        <Border Background="{DynamicResource NekoSurfaceSoftBrush}"
                                CornerRadius="10"
                                Padding="10,4">

                            <TextBlock Text="{Binding Status}"
                                       Foreground="{DynamicResource NekoSpiritWhiteBrush}"
                                       FontWeight="SemiBold"/>

                        </Border>

                        <Border Background="{DynamicResource NekoSpiritPurpleBrush}"
                                CornerRadius="10"
                                Padding="10,4"
                                Margin="8,0,0,0">

                            <TextBlock Text="{Binding Priority}"
                                       Foreground="White"
                                       FontWeight="SemiBold"/>

                        </Border>

                    </StackPanel>

                    <TextBlock Text="NEXT ACTION"
                               Style="{DynamicResource NekoTinyText}"
                               Margin="0,20,0,4"/>

                    <TextBlock Text="{Binding NextAction}"
                               Style="{DynamicResource NekoBodyText}"
                               FontWeight="SemiBold"/>

                </StackPanel>

                <!-- RIGHT -->
                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <TextBlock Text="BUSINESS VALUE"
                               Style="{DynamicResource NekoTinyText}"
                               HorizontalAlignment="Right"/>

                    <TextBlock Text="{Binding EstimatedBusinessValue,
                                              StringFormat=£{0:N0}}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource NekoMoneyBrush}"
                               HorizontalAlignment="Right"/>

                    <TextBlock Text="PROGRESS"
                               Style="{DynamicResource NekoTinyText}"
                               Margin="0,22,0,6"
                               HorizontalAlignment="Right"/>

                    <ProgressBar Width="150"
                                 Height="8"
                                 Maximum="100"
                                 Value="{Binding ProgressPercent}"/>

                    <TextBlock Text="{Binding ProgressPercent,
                                              StringFormat={}{0}% Complete}"
                               Style="{DynamicResource NekoTinyText}"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Right"/>

                    <TextBlock Text="{Binding EstimatedRemainingMinutes,
                                              StringFormat={}{0} mins remaining}"
                               Style="{DynamicResource NekoTinyText}"
                               Margin="0,16,0,0"
                               HorizontalAlignment="Right"/>

                    <TextBlock Text="{Binding DueAt,
                                              StringFormat=Due {0:dd MMM yyyy}}"
                               Style="{DynamicResource NekoTinyText}"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Right"/>

                </StackPanel>
            </Grid>

            <!-- ACTIONS -->
            <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,18,0,0">

                <Button Content="ASK GUARDIAN"
            Command="{Binding AskGuardianCommand, ElementName=Root}"
            CommandParameter="{Binding}"
            Width="130"
            Height="34"
            Margin="0,0,10,0"/>

                <Button Content="EDIT"
            Command="{Binding EditCommand, ElementName=Root}"
            CommandParameter="{Binding}"
            Width="90"
            Height="34"/>

                <Button Content="GENERATE TASKS"
        Command="{Binding GenerateTasksCommand, ElementName=Root}"
        CommandParameter="{Binding}"
        Width="140"
        Height="34"
        Margin="0,0,10,0"/>
            </StackPanel>

        </Grid>

    </Border>

</UserControl>