<UserControl x:Class="Nekomata.UI.Controls.Dashboard.MissionHistoryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="520"
             d:DesignHeight="430">

    <Border Background="{DynamicResource NekoCardGradientBrush}"
            BorderBrush="#34485D"
            BorderThickness="1"
            CornerRadius="18"
            Padding="22">

        <StackPanel>

            <!-- Header -->
            <Grid Margin="0,0,0,18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="RECENT MISSIONS"
                               Foreground="#F5F7FC"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Latest completed and cancelled sessions"
                               Foreground="#8296AB"
                               FontSize="12"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#20314A"
                        CornerRadius="10"
                        Padding="11,7"
                        VerticalAlignment="Top">

                    <TextBlock Text="{Binding RecentMissionHistory.Count,
                                              StringFormat={}{0} RECORDED}"
                               Foreground="#9FB2C7"
                               FontSize="10"
                               FontWeight="SemiBold"/>

                </Border>

            </Grid>

            <ItemsControl ItemsSource="{Binding RecentMissionHistory}">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border Background="#132235"
                                BorderBrush="#263A50"
                                BorderThickness="1"
                                CornerRadius="13"
                                Padding="14"
                                Margin="0,0,0,10">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Status icon -->
                                <Border Width="30"
                                        Height="30"
                                        CornerRadius="15"
                                        Background="#25384D"
                                        VerticalAlignment="Center">

                                    <TextBlock x:Name="StatusIcon"
                                               Text="•"
                                               Foreground="#9FB2C7"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <!-- Mission details -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="{Binding Title}"
                                               Foreground="#F2F5FA"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,5,0,0">

                                        <TextBlock Text="{Binding FinishedAt,
                                                                  StringFormat={}{0:HH:mm}}"
                                                   Foreground="#7890AA"
                                                   FontSize="11"/>

                                        <TextBlock Text="  •  "
                                                   Foreground="#4B6177"
                                                   FontSize="11"/>

                                        <TextBlock Text="{Binding ActualDurationMinutes,
                                                                  StringFormat={}{0} mins}"
                                                   Foreground="#7890AA"
                                                   FontSize="11"/>

                                        <TextBlock Text="  •  "
                                                   Foreground="#4B6177"
                                                   FontSize="11"/>

                                        <TextBlock x:Name="StatusText"
                                                   Text="Recorded"
                                                   Foreground="#9FB2C7"
                                                   FontSize="11"/>

                                    </StackPanel>

                                </StackPanel>

                                <!-- Score -->
                                <StackPanel Grid.Column="2"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">

                                    <TextBlock Text="{Binding Score}"
                                               Foreground="#B9A9FF"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Right"/>

                                    <TextBlock Text="SCORE"
                                               Foreground="#61768C"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                        <DataTemplate.Triggers>

                            <DataTrigger Binding="{Binding Completed}"
                                         Value="True">

                                <Setter TargetName="StatusIcon"
                                        Property="Text"
                                        Value="✓"/>

                                <Setter TargetName="StatusIcon"
                                        Property="Foreground"
                                        Value="#61D6A0"/>

                                <Setter TargetName="StatusText"
                                        Property="Text"
                                        Value="Completed"/>

                                <Setter TargetName="StatusText"
                                        Property="Foreground"
                                        Value="#61D6A0"/>

                            </DataTrigger>

                            <DataTrigger Binding="{Binding Cancelled}"
                                         Value="True">

                                <Setter TargetName="StatusIcon"
                                        Property="Text"
                                        Value="×"/>

                                <Setter TargetName="StatusIcon"
                                        Property="Foreground"
                                        Value="#FF7388"/>

                                <Setter TargetName="StatusText"
                                        Property="Text"
                                        Value="Cancelled"/>

                                <Setter TargetName="StatusText"
                                        Property="Foreground"
                                        Value="#FF7388"/>

                            </DataTrigger>

                        </DataTemplate.Triggers>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <!-- Empty-state text remains useful before the first session -->
            <TextBlock Text="Complete a mission to begin building your history."
                       Foreground="#60758A"
                       FontSize="12"
                       TextAlignment="Center"
                       Margin="0,12,0,2"/>

        </StackPanel>

    </Border>

</UserControl>