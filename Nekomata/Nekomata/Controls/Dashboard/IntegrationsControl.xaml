<UserControl x:Class="Nekomata.UI.Controls.Dashboard.IntegrationsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="22" Padding="22" Margin="0,0,0,16"
            Background="{DynamicResource NekoHeaderGradientBrush}"
            BorderBrush="{DynamicResource NekoSpiritPurpleBrush}" BorderThickness="1">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="INTEGRATIONS" Foreground="{DynamicResource NekoAccentBrush}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="MUSIC &amp; SECURITY" Foreground="{DynamicResource NekoSpiritWhiteBrush}" FontSize="23" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Content="REFRESH" Command="{Binding RefreshIntegrationsCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,6"/>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource NekoSurfaceAltBrush}" BorderBrush="{DynamicResource NekoBorderSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel>
                            <Border Width="10" Height="10" CornerRadius="5" Background="#1ED760" DockPanel.Dock="Left" Margin="0,0,9,0"/>
                            <TextBlock Text="SPOTIFY" Foreground="{DynamicResource NekoSpiritWhiteBrush}" FontSize="16" FontWeight="Bold"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{Binding SpotifyIntegrationStatus}" Foreground="{DynamicResource NekoSuccessBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <StackPanel Grid.Row="2" Margin="0,10,0,10">
                            <TextBlock Text="{Binding SpotifyTrack}" Foreground="{DynamicResource NekoSpiritWhiteBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SpotifyArtist}" Foreground="{DynamicResource NekoMutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding SpotifyDevice, StringFormat=Playing on {0}}" Foreground="{DynamicResource NekoMutedTextBrush}" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="3" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="PREV" Command="{Binding SpotifyPreviousCommand}" Margin="0,0,5,0"/>
                            <Button Grid.Column="1" Content="{Binding SpotifyPlayPauseLabel}" Command="{Binding ToggleSpotifyPlaybackCommand}" Margin="0,0,5,0"/>
                            <Button Grid.Column="2" Content="NEXT" Command="{Binding SpotifyNextCommand}" Margin="0,0,5,0"/>
                            <Button Grid.Column="3" Content="VOL -" Command="{Binding SpotifyVolumeDownCommand}" Margin="0,0,5,0"/>
                            <Button Grid.Column="4" Content="VOL +" Command="{Binding SpotifyVolumeUpCommand}"/>
                        </Grid>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{Binding SpotifyConnectLabel}" Command="{Binding ConnectSpotifyCommand}" Height="34"/>
                            <Button Grid.Column="2" Content="{Binding SpotifyShuffleLabel}" Command="{Binding ToggleSpotifyShuffleCommand}" MinWidth="105" Height="34"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource NekoSurfaceAltBrush}" BorderBrush="{DynamicResource NekoBorderSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel>
                            <Border Width="10" Height="10" CornerRadius="5" DockPanel.Dock="Left" Margin="0,0,9,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource NekoCriticalBrush}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsKnowBe4Connected}" Value="True"><Setter Property="Background" Value="{DynamicResource NekoSuccessBrush}"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="KNOWBE4" Foreground="{DynamicResource NekoSpiritWhiteBrush}" FontSize="16" FontWeight="Bold"/>
                            <Border Background="#332A2442" CornerRadius="8" Padding="8,3" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding KnowBe4FailureCount, StringFormat={}{0} RECENT}" Foreground="{DynamicResource NekoWarningBrush}" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{Binding KnowBe4IntegrationStatus}" Foreground="{DynamicResource NekoSuccessBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="2" Text="Monitoring simulation clicks, replies, attachments, macros, entered data and QR scans." Foreground="{DynamicResource NekoMutedTextBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,8,0,14"/>
                        <Button Grid.Row="3" Content="VIEW SECURITY ALERTS" Command="{Binding ShowKnowBe4AttentionCommand}" Height="34"/>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>