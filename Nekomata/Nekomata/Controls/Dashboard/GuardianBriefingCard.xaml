<UserControl x:Class="Nekomata.UI.Controls.Dashboard.GuardianBriefingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1300"
             d:DesignHeight="620">

    <UserControl.Resources>
        <Style x:Key="TimelineActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="62"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TimelinePrimaryButton" TargetType="Button" BasedOn="{StaticResource TimelineActionButton}">
            <Setter Property="Background" Value="{DynamicResource NekoSpiritPurpleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NekoSpiritWhiteBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NekoSpiritPurpleBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="TimelineQuietButton" TargetType="Button" BasedOn="{StaticResource TimelineActionButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource NekoMutedTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderSoftBrush}"/>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource NekoHeaderGradientBrush}"
            BorderBrush="{DynamicResource NekoSpiritPurpleBrush}"
            BorderThickness="1"
            CornerRadius="22"
            Padding="24">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===================================================== -->
            <!-- HEADER                                                -->
            <!-- ===================================================== -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <StackPanel Orientation="Horizontal">

                        <Border Background="#27204A"
                                BorderBrush="{DynamicResource NekoSpiritPurpleBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="10,5"
                                Margin="0,0,10,0">

                            <TextBlock Text="GUARDIAN"
                                       Foreground="{DynamicResource NekoSpiritPurpleBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"/>

                        </Border>

                        <TextBlock Text="DAILY BRIEFING"
                                   Foreground="{DynamicResource NekoAccentBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <TextBlock Text="{Binding Workspace.Briefing.Greeting}"
                               Foreground="{DynamicResource NekoSpiritWhiteBrush}"
                               FontSize="29"
                               FontWeight="Bold"
                               Margin="0,14,0,0"/>

                    <TextBlock Text="{Binding Workspace.Briefing.Headline}"
                               Foreground="{DynamicResource NekoTextBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,7,24,0"/>
                    <TextBlock Text="{Binding Workspace.Briefing.AiSummary}"
                               Foreground="{DynamicResource NekoMutedTextBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               LineHeight="20"
                               MaxWidth="850"
                               HorizontalAlignment="Left"
                               Margin="0,7,24,0"/>
                    <TextBlock Text="{Binding Workspace.Briefing.CalendarSummary}"
                               Foreground="{DynamicResource NekoTextBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               Margin="0,10,24,0"/>

                    <TextBlock Text="{Binding Workspace.Briefing.MeetingSummary}"
                               Foreground="{DynamicResource NekoMutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               Margin="0,6,24,0"/>

                    <TextBlock Text="{Binding Workspace.Briefing.AwarenessSummary}"
                               Foreground="{DynamicResource NekoWarningBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               Margin="0,6,24,0"/>
                    <Grid Margin="0,18,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ASK GUARDIAN"
                                   Style="{DynamicResource NekoSectionTitleText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding ChatInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Height="42"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 ToolTip="Ask Guardian to plan, prioritise or manage your calendar. Press Enter to send."
                                 Background="{DynamicResource NekoSurfaceBrush}"
                                 Foreground="{DynamicResource NekoTextBrush}"
                                 BorderBrush="{DynamicResource NekoBorderSoftBrush}"
                                 BorderThickness="1">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SendGuardianMessageCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="2"
                                Content="SEND"
                                Command="{Binding SendGuardianMessageCommand}"
                                Margin="10,0,0,0"
                                Height="42"/>
                    </Grid>

                </StackPanel>

              
                <StackPanel Grid.Column="2"
            VerticalAlignment="Top">

                    <!-- Capacity -->

                    <Border Background="#111D2A"
            BorderBrush="{DynamicResource NekoBorderBrush}"
            BorderThickness="1"
            CornerRadius="15"
            Padding="18"
            MinWidth="190">

                        <StackPanel>

                            <TextBlock Text="WORKDAY BOOKED"
                       Foreground="{DynamicResource NekoMutedTextBrush}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding Workspace.Briefing.CapacityUsedPercent,
              StringFormat={}{0:F0}%}"
                       Foreground="{DynamicResource NekoAccentBrush}"
                       FontSize="30"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,7,0,0"/>

                            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding Workspace.Briefing.CapacityUsedPercent}"
                         Height="6"
                         Margin="0,9,0,0"
                         Background="{DynamicResource NekoSurfaceAltBrush}"
                         Foreground="{DynamicResource NekoAccentBrush}"
                         BorderThickness="0"/>

                            <TextBlock Text="{Binding CapacityBreakdownText}"
                                       Foreground="{DynamicResource NekoTextBrush}"
                                       FontSize="9" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>

                            <TextBlock
    Text="{Binding Workspace.Briefing.CapacitySummary}"
    Foreground="{DynamicResource NekoMutedTextBrush}"
    FontSize="10"
    TextWrapping="Wrap"
    TextAlignment="Center"
    Margin="0,9,0,0"/>

                            <Border Background="{DynamicResource NekoSurfaceAltBrush}" CornerRadius="8" Padding="9" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Workspace.Capacity.BurnoutRisk, StringFormat=BURNOUT RISK · {0}}"
                                               Foreground="{DynamicResource NekoWarningBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Workspace.Capacity.OvertimeMinutesWorked, StringFormat=Overtime worked: {0} min}"
                                               Foreground="{DynamicResource NekoMutedTextBrush}" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                    </Border>

                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,16,0,0" Padding="12" CornerRadius="12"
                    Background="{DynamicResource NekoSurfaceAltBrush}"
                    BorderBrush="{DynamicResource NekoBorderSoftBrush}" BorderThickness="1">
                <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding NowTimelineText}"
                                   Foreground="{DynamicResource NekoSuccessBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <Button Grid.Column="1"
                                Content="{Binding NowTimelineActionText}"
                                Command="{Binding ActivateNowTimelineCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TimelineActionButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNowTimelineAction}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <Grid Grid.Column="1" Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding NextTimelineText}"
                                   Foreground="{DynamicResource NekoAccentBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="OPEN" Command="{Binding OpenNextTimelineCommand}" Margin="0,0,7,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TimelineActionButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNextTimelineAction}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="2" Content="ADJUST" Command="{Binding AdjustNextTimelineCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TimelineActionButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNextTimelineAction}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <Grid Grid.Column="2" Margin="14,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ThenTimelineText}"
                                   Foreground="{DynamicResource NekoMutedTextBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="OPEN" Command="{Binding OpenThenTimelineCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TimelineActionButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasThenTimelineAction}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding PlanHealthTitle}" Foreground="{DynamicResource NekoWarningBrush}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding PlanHealthDetail}" Foreground="{DynamicResource NekoMutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,12,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="START NOW" Command="{Binding StartPlanAlertCommand}" Margin="0,0,8,0">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TimelinePrimaryButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding PlanAttentionVisible}" Value="True"/><Condition Binding="{Binding CanStartPlanAlert}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                            <Button Content="REPAIR PLAN" Command="{Binding RepairCalendarPlanCommand}" Margin="0,0,8,0">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TimelineActionButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding PlanAttentionVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                            <Button Content="DISMISS" Command="{Binding DismissPlanAlertCommand}">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TimelineQuietButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding PlanAttentionVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===================================================== -->
            <!-- MAIN BRIEFING BODY                                    -->
            <!-- ===================================================== -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.85*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <!-- ================================================= -->
                <!-- YESTERDAY                                         -->
                <!-- ================================================= -->

                <Border Grid.Column="0"
                        Background="#111E2C"
                        BorderBrush="{DynamicResource NekoBorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="15"
                        Padding="18">

                    <StackPanel>

                        <TextBlock Text="YESTERDAY"
                                   Foreground="{DynamicResource NekoMutedTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding Workspace.Briefing.MissionsCompletedYesterday}"
                                   Foreground="{DynamicResource NekoSuccessBrush}"
                                   FontSize="29"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="MISSIONS COMPLETED"
                                   Foreground="{DynamicResource NekoMutedTextBrush}"
                                   FontSize="10"/>

                        <Grid Margin="0,17,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Focus"
                                       Foreground="{DynamicResource NekoMutedTextBrush}"/>

                            <TextBlock Grid.Column="1"
           Text="{Binding Workspace.Briefing.FocusTimeYesterdayFormatted}"
           Foreground="{DynamicResource NekoTextBrush}"
           FontWeight="SemiBold"/>

                        </Grid>

                        <Grid Margin="0,9,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Value"
                                       Foreground="{DynamicResource NekoMutedTextBrush}"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Workspace.Briefing.BusinessValueYesterday,
                                                      StringFormat=£{0:N0}}"
                                       Foreground="{DynamicResource NekoMoneyBrush}"
                                       FontWeight="SemiBold"/>

                        </Grid>

                        <Grid Margin="0,9,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Average score"
                                       Foreground="{DynamicResource NekoMutedTextBrush}"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Workspace.Briefing.AverageScoreYesterday,
                                                      StringFormat={}{0:F0}}"
                                       Foreground="{DynamicResource NekoWarningBrush}"
                                       FontWeight="SemiBold"/>

                        </Grid>

                        <Border Background="#17283B"
                                CornerRadius="10"
                                Padding="11"
                                Margin="0,16,0,0">

                            <TextBlock Text="{Binding Workspace.Briefing.YesterdaySummary}"
                                       Foreground="{DynamicResource NekoMutedTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       LineHeight="16"/>

                        </Border>

                    </StackPanel>

                </Border>

                <!-- ================================================= -->
                <!-- TODAY'S OBJECTIVE                                 -->
                <!-- ================================================= -->

                <Border Grid.Column="2"
                        Background="#152338"
                        BorderBrush="{DynamicResource NekoSpiritPurpleBrush}"
                        BorderThickness="1"
                        CornerRadius="15"
                        Padding="20">

                    <Grid>

                        <!-- Real objective -->

                        <Grid>

                            <Grid.Style>
                                <Style TargetType="Grid">

                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding HasBriefingObjective}"
                                                     Value="False">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="TODAY'S OBJECTIVE"
                                       Foreground="{DynamicResource NekoSpiritPurpleBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

                            <StackPanel Grid.Row="1"
                                        Margin="0,11,0,14">

                                <TextBlock Text="{Binding Workspace.Briefing.ObjectiveTitle}"
                                           Foreground="{DynamicResource NekoSpiritWhiteBrush}"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding Workspace.Briefing.ObjectiveReason}"
                                           Foreground="{DynamicResource NekoMutedTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           LineHeight="18"
                                           Margin="0,7,0,0"/>

                                <UniformGrid Columns="3"
                                             Margin="0,18,0,0">

                                    <StackPanel>

                                        <TextBlock Text="SCORE"
                                                   Foreground="{DynamicResource NekoMutedTextBrush}"
                                                   FontSize="9"/>

                                        <TextBlock Text="{Binding Workspace.Briefing.ObjectiveScore}"
                                                   Foreground="{DynamicResource NekoSpiritPurpleBrush}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Margin="0,4,0,0"/>

                                    </StackPanel>

                                    <StackPanel>

                                        <TextBlock Text="VALUE"
                                                   Foreground="{DynamicResource NekoMutedTextBrush}"
                                                   FontSize="9"/>

                                        <TextBlock Text="{Binding Workspace.Briefing.ObjectiveBusinessValue,
                                                                  StringFormat=£{0:N0}}"
                                                   Foreground="{DynamicResource NekoMoneyBrush}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Margin="0,4,0,0"/>

                                    </StackPanel>

                                    <StackPanel>

                                        <TextBlock Text="ESTIMATE"
                                                   Foreground="{DynamicResource NekoMutedTextBrush}"
                                                   FontSize="9"/>

                                        <TextBlock Text="{Binding Workspace.Briefing.ObjectiveEstimatedTimeFormatted}"
           Foreground="{DynamicResource NekoTextBrush}"
           FontSize="18"
           FontWeight="Bold"
           Margin="0,4,0,0"/>

                                    </StackPanel>

                                </UniformGrid>

                            </StackPanel>

                            <Grid Grid.Row="2">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.4*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="0.6*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
            Content="VIEW ANALYSIS"
            Command="{Binding OpenMissionAnalysisCommand}"
            Height="42"
            HorizontalAlignment="Stretch"
            FontWeight="SemiBold"/>

                                <Button Grid.Column="2"
            Content="BEGIN TODAY'S OBJECTIVE"
            Command="{Binding BeginMissionCommand}"
            Height="42"
            HorizontalAlignment="Stretch"
            FontWeight="SemiBold"/>

                            </Grid>
                        </Grid>

                        <!-- Empty objective state -->

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="25">

                            <StackPanel.Style>
                                <Style TargetType="StackPanel">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding HasBriefingObjective}"
                                                     Value="False">

                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </StackPanel.Style>

                            <Border Width="46"
                                    Height="46"
                                    CornerRadius="23"
                                    Background="#27204A"
                                    BorderBrush="{DynamicResource NekoSpiritPurpleBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center">

                                <TextBlock Text="◇"
                                           Foreground="{DynamicResource NekoSpiritPurpleBrush}"
                                           FontSize="23"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock Text="NO PRIMARY OBJECTIVE"
                                       Foreground="{DynamicResource NekoSpiritWhiteBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,13,0,0"/>

                            <TextBlock Text="Guardian will select an objective when suitable work is available."
                                       Foreground="{DynamicResource NekoMutedTextBrush}"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="340"
                                       Margin="0,7,0,0"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- ================================================= -->
                <!-- TODAY AND GUIDANCE                                -->
                <!-- ================================================= -->

                <Border Grid.Column="4"
                        Background="#111E2C"
                        BorderBrush="{DynamicResource NekoBorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="15"
                        Padding="18">

                    <StackPanel>

                        <TextBlock Text="TODAY"
                                   Foreground="{DynamicResource NekoMutedTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Completed" Foreground="{DynamicResource NekoMutedTextBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Workspace.Briefing.MissionsCompletedToday}"
                                       Foreground="{DynamicResource NekoSuccessBrush}" FontWeight="Bold"/>
                        </Grid>

                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Focus delivered" Foreground="{DynamicResource NekoMutedTextBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Workspace.Briefing.FocusTimeTodayFormatted}"
                                       Foreground="{DynamicResource NekoSuccessBrush}" FontWeight="Bold"/>
                        </Grid>

                        <Grid Margin="0,11,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Due today"
                                       Foreground="{DynamicResource NekoMutedTextBrush}"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Workspace.Briefing.TasksDueToday}"
                                       Foreground="{DynamicResource NekoTextBrush}"
                                       FontWeight="Bold"/>

                        </Grid>

                        <Grid Margin="0,9,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Overdue"
                                       Foreground="{DynamicResource NekoMutedTextBrush}"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Workspace.Briefing.OverdueTasks}"
                                       Foreground="{DynamicResource NekoCriticalBrush}"
                                       FontWeight="Bold"/>

                        </Grid>

                        <Grid Margin="0,9,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Critical"
                                       Foreground="{DynamicResource NekoMutedTextBrush}"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Workspace.Briefing.CriticalTasks}"
                                       Foreground="{DynamicResource NekoWarningBrush}"
                                       FontWeight="Bold"/>

                        </Grid>

                        <Grid Margin="0,9,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Calendar focus"
                                       Foreground="{DynamicResource NekoMutedTextBrush}"/>

                            <TextBlock Grid.Column="1"
           Text="{Binding Workspace.Briefing.PlannedTimeTodayFormatted}"
           Foreground="{DynamicResource NekoTextBrush}"
           FontWeight="Bold"/>

                        </Grid>

                        <Border Background="#17283B"
                                BorderBrush="{DynamicResource NekoBorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="13"
                                Margin="0,17,0,0">

                            <StackPanel>

                                <TextBlock Text="GUARDIAN SAYS"
                                           Foreground="{DynamicResource NekoAccentBrush}"
                                           FontSize="9"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="{Binding Workspace.Briefing.GuardianComment}"
                                           Foreground="{DynamicResource NekoTextBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           LineHeight="19"
                                           Margin="0,7,0,0"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- ===================================================== -->
            <!-- RECOMMENDATIONS AND RISKS                             -->
            <!-- ===================================================== -->

            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Recommendations -->

                <Border Grid.Column="0"
                        Background="#111E2C"
                        BorderBrush="{DynamicResource NekoBorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="15"
                        Padding="18">

                    <Border.Style>
                        <Style TargetType="Border">

                            <Setter Property="Visibility"
                                    Value="Visible"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding HasBriefingRecommendations}"
                                             Value="False">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>
                    </Border.Style>

                    <StackPanel>

                        <TextBlock Text="WHY GUARDIAN CHOSE THIS"
           Foreground="{DynamicResource NekoAccentBrush}"
           FontSize="11"
           FontWeight="SemiBold"
           Margin="0,0,0,11"/>

                        <ItemsControl ItemsSource="{Binding Workspace.Briefing.Opportunities}">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <StackPanel Margin="0,6">

                                        <TextBlock
            Text="{Binding Title}"
            FontWeight="SemiBold"
            Foreground="#E8F2FF"/>

                                        <TextBlock
            Text="{Binding Description}"
            Foreground="#93A4BD"
            TextWrapping="Wrap"/>

                                    </StackPanel>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

                <!-- Risks -->

                <Border Grid.Column="2"
                        Background="#111E2C"
                        BorderBrush="{DynamicResource NekoBorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="15"
                        Padding="18">

                    <Border.Style>
                        <Style TargetType="Border">

                            <Setter Property="Visibility"
                                    Value="Visible"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding HasBriefingRisks}"
                                             Value="False">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>
                    </Border.Style>

                    <StackPanel>

                        <TextBlock Text="RISKS"
                                   Foreground="{DynamicResource NekoWarningBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,11"/>

                        <ItemsControl ItemsSource="{Binding Workspace.Briefing.GuardianRisks}">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <StackPanel Margin="0,6">

                                        <TextBlock
            Text="{Binding Title}"
            FontWeight="SemiBold"
            Foreground="#FFD66B"/>

                                        <TextBlock
            Text="{Binding Description}"
            Foreground="#93A4BD"
            TextWrapping="Wrap"/>

                                    </StackPanel>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

            </Grid>
</Grid>

    </Border>

</UserControl>