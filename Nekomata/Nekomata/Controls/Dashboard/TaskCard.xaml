<UserControl x:Class="Nekomata.UI.Controls.Dashboard.TaskCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <Border Background="{DynamicResource NekoSurfaceAltBrush}"
            BorderBrush="{DynamicResource NekoBorderSoftBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="16"
            Margin="0,0,0,12">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT-HAND TASK INFORMATION -->
            <StackPanel Grid.Column="0">

                <TextBlock Text="{Binding Title}"
                           Foreground="{DynamicResource NekoTextBrush}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0,10,0,0">

                    <Border Background="#203447"
                            CornerRadius="8"
                            Padding="8,4"
                            Margin="0,0,8,0">

                        <TextBlock Text="{Binding Priority}"
                                   Foreground="{DynamicResource NekoLightningBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                    </Border>

                    <TextBlock Text="{Binding EstimatedMinutes,
                                              StringFormat={}{0} mins}"
                               Foreground="{DynamicResource NekoMutedTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="  •  "
                               Foreground="{DynamicResource NekoMutedTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding Owner}"
                               Foreground="{DynamicResource NekoMutedTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"/>

                </StackPanel>

                <!-- Decorative progress / focus line -->
                <Border Height="6"
                        CornerRadius="3"
                        Background="{DynamicResource NekoSurfaceSoftBrush}"
                        Margin="0,14,0,0">

                    <Grid>

                        <Border Width="90"
                                HorizontalAlignment="Left"
                                CornerRadius="3"
                                Background="{DynamicResource NekoSpiritPurpleBrush}"/>

                    </Grid>

                </Border>

            </StackPanel>

            <!-- RIGHT-HAND ACTIONS -->
            <StackPanel Grid.Column="1"
                        Margin="16,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <!-- Priority score -->
                <Border Width="42"
                        Height="42"
                        CornerRadius="21"
                        Background="#1B3A48"
                        HorizontalAlignment="Center">

                    <TextBlock Text="{Binding PriorityScore}"
                               Foreground="{DynamicResource NekoSuccessBrush}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>

                <!-- Complete task -->
                <Button Content="COMPLETE"
                        Command="{Binding CompleteCommand,
                                          ElementName=Root}"
                        CommandParameter="{Binding}"
                        Width="100"
                        Height="32"
                        Margin="0,12,0,0"/>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>