<UserControl x:Class="Nekomata.UI.Controls.Dashboard.HeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Padding="20"
            CornerRadius="22"
            Background="{DynamicResource NekoHeaderGradientBrush}"
            BorderBrush="{DynamicResource NekoBorderBrush}"
            BorderThickness="1">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="{Binding ApplicationName}"
                           Foreground="{DynamicResource NekoAccentBrush}"
                           FontSize="34"
                           FontWeight="Bold"/>

                <TextBlock Text="Guardian Command Centre"
                           Foreground="{DynamicResource NekoSpiritPurpleBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="2,3,0,0"/>

                <StackPanel Orientation="Horizontal"
                            Margin="2,8,0,0">

                    <TextBlock Text="{Binding Greeting}"
                               Foreground="{DynamicResource NekoTextBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding BriefingSummary}"
           Foreground="{DynamicResource NekoMutedTextBrush}"
           FontSize="13"
           Margin="2,7,0,0"
           TextWrapping="Wrap"
           MaxWidth="780"/>

                    <TextBlock Text="  "
                               FontSize="13"/>

                    <TextBlock Text="{Binding DashboardSummary}"
                               Foreground="{DynamicResource NekoMutedTextBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>