<UserControl x:Class="Nekomata.UI.Controls.Common.GuardianPresenceOrb"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True">

    <!--
        Guardian's "face": a glass-like sphere with a containment ring and a scanning
        dial around it, built to look deliberate even fully at rest, not just a dot that
        happens to move. Layers back to front:
          GlowEllipse   - soft blurred halo, pulses per state (Animations.xaml)
          OuterRing     - thin static ring, gives the orb a defined edge/vessel
          ScanRing      - dashed ring, always slowly rotating (speed/opacity per state;
                          see GuardianPresenceOrb.xaml.cs and Animations.xaml)
          CoreEllipse   - radial-gradient sphere with a bright centre fading to a deep
                          edge shade, so it reads as lit from within rather than flat-filled
          Highlight     - small static specular dot for a glossy, rendered look
        GuardianPresenceOrb.xaml.cs owns everything named here: colours (gradient stops,
        glow fill, scan stroke) and the scan ring's resting opacity are set/cross-faded in
        code; only the looping motion (scale pulses, rotation) lives in Animations.xaml.
    -->
    <Grid Width="60" Height="60">

        <Ellipse x:Name="GlowEllipse"
                 Width="60" Height="60"
                 Opacity="0.25"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <SolidColorBrush x:Name="GlowBrush" Color="#42D9FF"/>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="GlowScale" ScaleX="1" ScaleY="1"/>
            </Ellipse.RenderTransform>
            <Ellipse.Effect>
                <BlurEffect Radius="16"/>
            </Ellipse.Effect>
        </Ellipse>

        <Ellipse x:Name="OuterRing"
                 Width="46" Height="46"
                 Fill="Transparent"
                 StrokeThickness="1.2"
                 Opacity="0.5">
            <Ellipse.Stroke>
                <SolidColorBrush Color="#4A6780"/>
            </Ellipse.Stroke>
        </Ellipse>

        <Ellipse x:Name="ScanRing"
                 Width="46" Height="46"
                 Fill="Transparent"
                 StrokeThickness="2.2"
                 StrokeDashArray="1,2.8"
                 StrokeDashCap="Round"
                 Opacity="0.55">
            <Ellipse.Stroke>
                <SolidColorBrush x:Name="ScanBrush" Color="#42D9FF"/>
            </Ellipse.Stroke>
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="SweepRotate" Angle="0" CenterX="23" CenterY="23"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse x:Name="CoreEllipse"
                 Width="26" Height="26"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.35,0.3" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                    <GradientStop x:Name="CoreStopInner" Offset="0" Color="#FFFFFF"/>
                    <GradientStop x:Name="CoreStopMid" Offset="0.4" Color="#42D9FF"/>
                    <GradientStop x:Name="CoreStopEdge" Offset="1" Color="#163A4D"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="CoreScale" ScaleX="1" ScaleY="1"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse Width="7" Height="7"
                  Fill="#B3FFFFFF"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="21,19,0,0"
                  IsHitTestVisible="False"/>

    </Grid>

</UserControl>
